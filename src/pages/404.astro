---
/**
 * 404.
 *
 * Bare chrome, like /free-mock: logo, one line, one way back. The page used
 * to be written in the old space voice — "Lost in space.", "Back to Earth",
 * "Send us a signal" — which outlived the design it belonged to by five
 * phases.
 *
 * It also used to list every nav link. That is the one argument for giving
 * a 404 the full header, and it was deliberately dropped: the logo goes
 * home, the button goes home, and a wall of links is not what someone who
 * mistyped a URL is looking for.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../data/url.js';
---

<BaseLayout
  title="Page not found"
  description="That page doesn't exist — but the rest of the site does."
  bare
  noindex
>
  <section class="section lost">
    <div class="shell-narrow lost__inner">
      <p class="lost__code" aria-hidden="true">404</p>
      <h1>There's nothing at this address.</h1>
      <p class="lead">
        It may have moved, or the link may have a typo in it.
      </p>
      <p class="lost__back">
        <a class="btn btn--primary btn--lg" href={url('/')}>Back to the home page</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    display: grid;
    place-items: center;
    min-height: calc(100vh - 68px - 64px);
  }

  .lost__inner { text-align: center; }

  /* A quiet ghost numeral. Decorative — it repeats the page title and the
     heading, so it is hidden from assistive tech and exempt from the text
     contrast rule, but it still has to be visible, which on a light surface
     means a grey stroke. */
  .lost__code {
    font-family: var(--font-mono);
    font-size: clamp(4rem, 3rem + 10vw, 9rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1.5px #d2d5db;
    margin-bottom: var(--s-4);
    user-select: none;
  }

  .lost .lead { margin-inline: auto; }
  .lost__back { margin-top: var(--s-5); }
</style>
