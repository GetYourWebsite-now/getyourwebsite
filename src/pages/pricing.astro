---
import BaseLayout from '../layouts/BaseLayout.astro';
import TierCard from '../components/TierCard.astro';
import Faq from '../components/Faq.astro';
import {
  BETA,
  BETA_PERCENT,
  PRIMARY_CTA,
  STARTUP_TIERS,
  MAINTENANCE_TIERS,
  EVERY_PLAN_INCLUDES,
  PRICING_FAQ,
  money,
  startupPrice,
} from '../data/site.js';
import { url } from '../data/url.js';

// Built from the data rather than typed out. A hardcoded description is
// a second copy of every price, and the one place drift would not show up
// on the page itself — `npm run verify` greps for stray price strings
// precisely to stop this coming back.
const startupFrom = money(startupPrice(STARTUP_TIERS[0]));
const careFrom = money(MAINTENANCE_TIERS[0].monthly);
const description =
  `Startup plans from ${startupFrom}, one-time; Maintenance from ${careFrom}/mo. ` +
  'Priced by how many changes you want, not by pages.';
---

<BaseLayout
  title="Pricing"
  description={description}
>
  <!-- 1. Header ---------------------------------------------------------- -->
  <section class="section section--alt section--tight">
    <div class="shell">
      <div class="section-head" data-reveal>
        <h1>Pay for changes, not pages.</h1>
        <p class="lead">
          Every site starts with a Startup plan. Keep it current with a
          Maintenance plan. Both are priced by how many changes you'll want —
          and the more you include, the less each one costs.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. Startup ---------------------------------------------------------- -->
  <section class="section">
    <div class="shell">
      <div class="section-head" data-reveal>
        <h2>Startup</h2>
        <p class="lead">Builds your site. Paid once.</p>
      </div>

      <div class="grid grid-3 tiers" data-reveal-group>
        {STARTUP_TIERS.map((tier) => <TierCard tier={tier} reveal />)}
      </div>

      {
        BETA.on && (
          <p class="disclaimer" data-reveal>
            Beta prices: {BETA_PERCENT} off Startup for the first {BETA.seats} businesses.
            Maintenance is list price. <a href={url('/beta-terms')}>How the beta works</a>
          </p>
        )
      }
    </div>
  </section>

  <!-- 3. Maintenance ------------------------------------------------------ -->
  <section class="section section--alt">
    <div class="shell">
      <div class="section-head" data-reveal>
        <h2>Maintenance</h2>
        <p class="lead">Hosts your site and keeps it current. Monthly.</p>
      </div>

      <div class="grid grid-3 tiers" data-reveal-group>
        {MAINTENANCE_TIERS.map((tier) => <TierCard tier={tier} reveal />)}
      </div>
    </div>
  </section>

  <!-- 4. What a revision is ----------------------------------------------- -->
  <section class="section section--dark section--tight">
    <div class="shell-narrow revision" data-reveal>
      <h2>What a revision is</h2>
      <p>
        One change request, sent from your portal, applied as a new version.
        "Make the hero warmer and swap the photo" is one revision. A person
        reviews each one before it goes live.
      </p>
    </div>
  </section>

  <!-- 5. Every plan includes ---------------------------------------------- -->
  <section class="section section--alt section--tight">
    <div class="shell">
      <h2 class="includes__title" data-reveal>Every plan includes</h2>
      <ul class="includes" data-reveal-group>
        {
          EVERY_PLAN_INCLUDES.map((item) => (
            <li class="includes__item" data-reveal>
              {item}
            </li>
          ))
        }
      </ul>
      {/* The condition on two of the five, stated next to them (CLAUDE.md,
          rule 1), and Cloudflare's own figures one click away. */}
      <p class="includes__note" data-reveal>
        Hosting and your domain come with Maintenance.
        <a href="https://www.cloudflare.com/network/" target="_blank" rel="noopener noreferrer">Cloudflare's network, by their own figures<span class="sr-only"> (opens in a new tab)</span></a>
      </p>
    </div>
  </section>

  <!-- 6. FAQ -------------------------------------------------------------- -->
  <section class="section">
    <div class="shell-narrow">
      <div class="section-head" data-reveal>
        <h2>The things everyone asks</h2>
      </div>

      <div data-reveal>
        <Faq items={PRICING_FAQ} />
      </div>
    </div>
  </section>

  <!-- 7. CTA -------------------------------------------------------------- -->
  <section class="section section--alt cta-band">
    <div class="shell-narrow" style="text-align:center" data-reveal>
      {
        BETA.on ? (
          <>
            <h2 class="cta-band__title">We're in beta. Want in?</h2>
            <p class="lead" style="margin-inline:auto">
              We're taking on a small number of businesses — the first {BETA.seats} at {BETA_PERCENT} off.
            </p>
          </>
        ) : (
          <>
            <h2 class="cta-band__title">See your business online before you pay anything.</h2>
            <p class="lead" style="margin-inline:auto">
              Tell us about it and we'll send back a free mock of your homepage. No
              commitment, no cost, no catch.
            </p>
          </>
        )
      }
      <div class="btn-row btn-row--center" style="margin-top:var(--s-5)">
        <a class="btn btn--primary btn--lg" href={url(PRIMARY_CTA.href)}>{PRIMARY_CTA.label}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tiers { align-items: stretch; }

  .disclaimer {
    max-width: 46rem;
    margin: var(--s-6) auto 0;
    padding-left: var(--s-3);
    border-left: 2px solid var(--line-input);
    font-size: var(--t-small);
    color: var(--ink-soft);
  }

  .disclaimer a { white-space: nowrap; }

  /* What a revision is --------------------------------------------------- */

  .revision h2 {
    font-size: var(--t-h3);
    margin-bottom: var(--s-3);
  }

  .revision p { margin: 0; }

  /* Every plan includes --------------------------------------------------- */

  .includes__title {
    font-size: var(--t-h3);
    margin-bottom: var(--s-4);
  }

  .includes {
    display: grid;
    gap: var(--s-3) var(--s-5);
    grid-template-columns: 1fr;
  }

  .includes__item {
    position: relative;
    padding-left: 1.4rem;
    font-size: var(--t-small);
    color: var(--ink-soft);
  }

  .includes__item::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .cta-band__title {
    font-size: clamp(1.75rem, 1.25rem + 2.2vw, 2.6rem);
    margin-bottom: var(--s-4);
  }

  .includes__note {
    margin-top: var(--s-4);
    font-size: var(--t-small);
    color: var(--ink-soft);
  }

  @media (min-width: 760px) {
    .includes { grid-template-columns: repeat(3, 1fr); }
  }

  @media (min-width: 1100px) {
    .includes { grid-template-columns: repeat(5, 1fr); }
  }
</style>
