---
import BaseLayout from '../layouts/BaseLayout.astro';
import TierCard from '../components/TierCard.astro';
import CarePlan from '../components/CarePlan.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import Faq from '../components/Faq.astro';
import {
  BUILD_TIERS,
  CARE_PLAN,
  EVERY_PLAN_INCLUDES,
  PRICING_DISCLAIMER,
  PRICING_FAQ,
} from '../data/site.js';
import { url } from '../data/url.js';

// Built from the data rather than typed out. A hardcoded description is
// a second copy of every price, and the one place drift would not show up
// on the page itself — `npm run verify` greps for stray price strings
// precisely to stop this coming back.
const priced = BUILD_TIERS.map((t) => `${t.name} ${t.price}`).join(', ');
const description =
  `${priced} — one-time, plus a ${CARE_PLAN.price}${CARE_PLAN.period} Care plan to host ` +
  'and maintain it. The mock that starts every project is free.';
---

<BaseLayout
  title="Pricing"
  description={description}
>
  <!-- 1. Header ---------------------------------------------------------- -->
  <section class="section section--alt section--tight">
    <div class="shell">
      <div class="section-head" data-reveal>
        <h1>Simple prices. One of them is free.</h1>
        <p class="lead">
          Three ways to build, one plan to keep it running. The mock that
          starts every project costs nothing.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. Build tiers ------------------------------------------------------ -->
  <section class="section">
    <div class="shell">
      <h2 class="sr-only">Build tiers</h2>

      <div class="grid grid-3 tiers" data-reveal-group>
        {BUILD_TIERS.map((tier) => <TierCard tier={tier} reveal />)}
      </div>

      <p class="disclaimer" data-reveal>{PRICING_DISCLAIMER}</p>
    </div>
  </section>

  <!-- 3. Care plan -------------------------------------------------------- -->
  <section class="section section--alt">
    <div class="shell" data-reveal>
      <CarePlan />
    </div>
  </section>

  <!-- 4. Every plan includes ---------------------------------------------- -->
  <section class="section section--tight">
    <div class="shell">
      <h2 class="includes__title" data-reveal>Every plan includes</h2>
      <ul class="includes" data-reveal-group>
        {
          EVERY_PLAN_INCLUDES.map((item) => (
            <li class="includes__item" data-reveal>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. Comparison ------------------------------------------------------- -->
  <section class="section section--alt">
    <div class="shell">
      <div class="section-head" data-reveal>
        <h2>What each tier gets you</h2>
      </div>

      <div data-reveal>
        <ComparisonTable />
      </div>
    </div>
  </section>

  <!-- 6. FAQ -------------------------------------------------------------- -->
  <section class="section">
    <div class="shell-narrow">
      <div class="section-head" data-reveal>
        <h2>The things everyone asks</h2>
      </div>

      <div data-reveal>
        <Faq items={PRICING_FAQ} />
      </div>
    </div>
  </section>

  <!-- 7. CTA -------------------------------------------------------------- -->
  <section class="section section--alt cta-band">
    <div class="shell-narrow" style="text-align:center" data-reveal>
      <h2 class="cta-band__title">See your business online before you pay anything.</h2>
      <p class="lead" style="margin-inline:auto">
        Tell us about it and we'll send back a free mock of your homepage. No
        commitment, no cost, no catch.
      </p>
      <div class="btn-row btn-row--center" style="margin-top:var(--s-5)">
        <a class="btn btn--primary btn--lg" href={url('/free-mock')}>Get a free mock</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tiers { align-items: stretch; }

  .disclaimer {
    max-width: 46rem;
    margin: var(--s-6) auto 0;
    padding-left: var(--s-3);
    border-left: 2px solid var(--line-input);
    font-size: var(--t-small);
    color: var(--ink-muted);
  }

  /* Every plan includes --------------------------------------------------- */

  .includes__title {
    font-size: var(--t-h3);
    margin-bottom: var(--s-4);
  }

  .includes {
    display: grid;
    gap: var(--s-3) var(--s-5);
    grid-template-columns: 1fr;
  }

  .includes__item {
    position: relative;
    padding-left: 1.4rem;
    font-size: var(--t-small);
    color: var(--ink-soft);
  }

  .includes__item::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .cta-band__title {
    font-size: clamp(1.75rem, 1.25rem + 2.2vw, 2.6rem);
    margin-bottom: var(--s-4);
  }

  @media (min-width: 760px) {
    .includes { grid-template-columns: repeat(4, 1fr); }
  }
</style>
