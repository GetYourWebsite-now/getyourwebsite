---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudy from '../components/CaseStudy.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { BETA, BETA_PERCENT, PRIMARY_CTA, LIVE_SITES, CONCEPT_PROJECTS } from '../data/site.js';
import { url } from '../data/url.js';
---

<BaseLayout
  title="Work"
  description="Two live sites — Allergy Rescue Kit, built for a client, and Andy's Auto Shop, built and hosted by our platform — plus six concept sites we built for fictional businesses to show range."
>
  <section class="section section--dark section--tight page-head">
    <div class="shell">
      <div class="section-head" data-reveal>
        <h1>Work</h1>
        <p class="lead">
          Two live sites, and six concept sites we built for fictional
          businesses to show range. Every one of them is a complete,
          working build — open any of them and click around.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 1 — the live sites, leading the page --------------------- -->
  <section class="section">
    <div class="shell">
      <div class="section-head" data-reveal>
        <h2>Live sites</h2>
      </div>

      <div class="cases">
        {
          LIVE_SITES.map((project, i) => (
            <div class="cases__item" data-reveal>
              <CaseStudy project={project} flip={i % 2 === 1} level={3} priority={i === 0} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Section 2 — the concept sites, quieter and labelled honestly ------ -->
  <section class="section section--alt">
    <div class="shell">
      <div class="section-head" data-reveal>
        <h2>Concept sites — fictional businesses we built to show range</h2>
        <p class="lead">
          None of these are clients. We invented the business, wrote the copy
          and built the site, so you can see what a bakery or a gym or a
          dental practice would get. They are full working sites, not pictures
          of sites.
        </p>
      </div>

      <div class="grid grid-3 concepts" data-reveal-group>
        {CONCEPT_PROJECTS.map((project) => <ProjectCard project={project} reveal quiet level={3} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell-narrow" style="text-align:center" data-reveal>
      {
        BETA.on ? (
          <>
            <h2>Want one of these with your name on it?</h2>
            <p class="lead" style="margin-inline:auto">
              We're in beta, taking on a small number of businesses — the first {BETA.seats} at {BETA_PERCENT} off.
            </p>
          </>
        ) : (
          <>
            <h2>Want one of these with your name on it?</h2>
            <p class="lead" style="margin-inline:auto">
              Tell us about your business and we'll build you a free mock of your
              homepage — the same quality as everything above, with your brand, your
              words and your photos.
            </p>
          </>
        )
      }
      <div class="btn-row btn-row--center" style="margin-top:var(--s-5)">
        <a class="btn btn--primary btn--lg" href={url(PRIMARY_CTA.href)}>{PRIMARY_CTA.label}</a>
        <a class="btn btn--secondary btn--lg" href={url('/pricing')}>See pricing</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head .section-head { margin-bottom: 0; }

  .cases {
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
  }

  /* A rule between the two cases, so they read as two pieces of work rather
     than one long block. */
  .cases__item + .cases__item {
    padding-top: var(--s-8);
    border-top: 1px solid var(--line);
  }

  /* The concept grid is deliberately quieter than the client work above it:
     smaller cards in a tighter grid. The hierarchy IS the honesty here — if
     a fictional bakery looks as important as a paying client's site, the
     page is overstating what we have done. */
  .concepts { gap: var(--s-4); }
</style>
