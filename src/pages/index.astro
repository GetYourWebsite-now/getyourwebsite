---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudy from '../components/CaseStudy.astro';
import VersionTree from '../components/VersionTree.astro';
import TierCard from '../components/TierCard.astro';
import MergeAnim from '../components/anim/MergeAnim.astro';
import ClickToChange from '../components/anim/ClickToChange.astro';
import PhotoDrop from '../components/anim/PhotoDrop.astro';
import DomainConnect from '../components/anim/DomainConnect.astro';
import {
  BETA,
  BETA_PERCENT,
  PRIMARY_CTA,
  LIVE_SITES,
  STARTUP_TIERS,
  MAINTENANCE_TIERS,
  money,
} from '../data/site.js';
import { url } from '../data/url.js';

const host = (p) => p.href.replace(/^https?:\/\//, '').replace(/\/$/, '');
const maintenanceLine = `Hosting and upkeep: Maintenance from ${money(MAINTENANCE_TIERS[0].monthly)}/mo.`;
---

<BaseLayout
  title="GetYourWebsite"
  description={BETA.on
    ? "Websites for local businesses, done for you. We build the site, host it and keep it current — every version kept, and a person checks every change before it goes live."
    : "Websites for local businesses, done for you. A free mock first, then we build the site, host it and keep it current — every version kept, one button to choose what's live."}
>
  <!-- 1. Hero ------------------------------------------------------------
       Left: the offer, and that we do the work. Right: the version tree,
       drawn rather than screenshotted — see VersionTree.astro.
  -->
  <section class="section section--hero">
    <div class="shell hero">
      <div class="hero__copy">
        <p class="eyebrow">Websites for local businesses</p>
        {/* Non-breaking space before the em dash: without it the line broke
            as "Your business online / — built, hosted, and", starting a line
            with a dash. A dash binds to the word before it. */}
        <h1 class="hero__title">
          Your business online&nbsp;— built, hosted, and kept current for you.
        </h1>
        <p class="lead hero__lead">
          You never touch a website builder. Tell us about the business; we
          build it, host it and keep it current.
        </p>
        <div class="btn-row hero__cta">
          <a class="btn btn--primary btn--lg" href={url(PRIMARY_CTA.href)}>{PRIMARY_CTA.label}</a>
          <a
            class="btn btn--secondary btn--lg"
            href="https://allergyrescuekit.com"
            target="_blank"
            rel="noopener noreferrer"
          >
            See a live client site
            <span class="sr-only">— Allergy Rescue Kit (opens in a new tab)</span>
          </a>
        </div>
        {
          BETA.on && (
            <p class="hero__beta">
              In beta. We're taking on a small number of businesses — the first {BETA.seats} at {BETA_PERCENT} off.
            </p>
          )
        }
        {/* One line, so the separator does not pick up a text node from a
            newline (CLAUDE.md, trap 3). */}
        <p class="hero__live">
          Live now at <a href={LIVE_SITES[0].href} target="_blank" rel="noopener noreferrer">{host(LIVE_SITES[0])}</a> and <a href={LIVE_SITES[1].href} target="_blank" rel="noopener noreferrer">{host(LIVE_SITES[1])}</a>.
        </p>
      </div>

      <figure class="hero__shot">
        <div class="browser">
          <div class="browser__bar" aria-hidden="true">
            <span></span><span></span><span></span>
            <div class="browser__url">portal.getyourwebsite.now</div>
          </div>
          <VersionTree />
        </div>
        <figcaption class="hero__caption">
          Your version tree. One button decides which version is live.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 2. Who does the work ---------------------------------------------------
       The positioning, as a drawing. Replaced the with/without-a-website
       comparison, which lives on /why-us now.
  -->
  <section class="section section--alt">
    <div class="shell">
      <MergeAnim />
    </div>
  </section>

  <!-- 3. The two live sites ---------------------------------------------- -->
  <section class="section">
    <div class="shell">
      <div class="section-head" data-reveal>
        <h2>Two live sites.</h2>
        <p class="lead">
          One we built by hand for a client. One our platform built and hosts.
          Both open to anyone.
        </p>
      </div>

      <div class="cases-2up" data-reveal-group>
        {
          LIVE_SITES.map((project) => (
            <div data-reveal>
              <CaseStudy project={project} compact level={3} />
            </div>
          ))
        }
      </div>

      <p class="section-more" data-reveal>
        <a class="link-arrow" href={url('/work')}>See all work</a>
      </p>
    </div>
  </section>

  <!-- 4. How it works — three steps, typography only ---------------------
       When and how you pay is in the pricing FAQ, where someone deciding
       to pay is looking for it.
  -->
  <section class="section section--alt">
    <div class="shell">
      <div class="section-head" data-reveal>
        <h2>{BETA.on ? 'Three steps to a live site.' : 'Three steps, and the first is free.'}</h2>
      </div>

      <ol class="steps" data-reveal-group>
        {
          BETA.on ? (
            <>
              <li class="step" data-reveal>
                <span class="step__num">01</span>
                <h3>You tell us about the business</h3>
                <p>A few details through the form. We reply within one business day.</p>
              </li>
              <li class="step" data-reveal>
                <span class="step__num">02</span>
                <h3>Pick a plan, and we build</h3>
                <p>Buy your Startup plan in the portal, then we build the full site.</p>
              </li>
            </>
          ) : (
            <>
              <li class="step" data-reveal>
                <span class="step__num">01</span>
                <h3>A free mock</h3>
                <p>Tell us about your business. We send back a homepage concept, free.</p>
              </li>
              <li class="step" data-reveal>
                <span class="step__num">02</span>
                <h3>Approve and start</h3>
                <p>Like it? We confirm the price, then build the full site.</p>
              </li>
            </>
          )
        }
        <li class="step" data-reveal>
          <span class="step__num">03</span>
          <h3>We run it for you</h3>
          <p>On Maintenance we host it and keep every change.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- 5. Platform ----------------------------------------------------------
       One real capture of the portal, then three drawings of the things it
       does that a still can't show. The drawings replaced three paragraphs.
  -->
  <section class="section">
    <div class="shell">
      <div class="section-head" data-reveal>
        <h2>Running the site is the part we built.</h2>
        <p class="lead">Every client gets this portal.</p>
        <p class="section-head__link">
          <a class="link-arrow" href={url('/demo')}>Try it in the demo</a>
        </p>
      </div>

      <figure class="platform-shot shot" data-reveal>
        <img
          src={url('/shots/portal-my-website.webp')}
          alt="The My website tab in the client portal, showing the live version, a list of approved versions, and Open, Quick edit, Request changes and Attach images buttons on each."
          width="1300"
          height="763"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="feature" data-reveal>
        <div class="feature__visual"><ClickToChange /></div>
        <div class="feature__copy">
          <h3>Click it. Say what to change.</h3>
          <p>No emails describing paragraphs. A person builds and reviews every change.</p>
        </div>
      </div>

      <div class="feature feature--flip" data-reveal>
        <div class="feature__visual"><PhotoDrop /></div>
        <div class="feature__copy">
          <h3>Your photos, dragged into place.</h3>
          <p>Drop your own pictures onto your site's photo slots, and save.</p>
        </div>
      </div>

      <div class="feature" data-reveal>
        <div class="feature__visual"><DomainConnect /></div>
        <div class="feature__copy">
          <h3>Your domain, handled.</h3>
          <p>
            Hosted on Cloudflare's network: hundreds of cities in 100+
            countries, by their own figures.
          </p>
          <p class="card__note">
            <a href="https://www.cloudflare.com/network/" target="_blank" rel="noopener noreferrer">
              Check Cloudflare's figures
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Pricing teaser ---------------------------------------------------
       Reads STARTUP_TIERS, the same array /pricing renders, so the two can
       never drift apart again. Teaser cards: name, price and revisions; the
       rest is one click away.
  -->
  <section class="section section--alt">
    <div class="shell">
      <div class="section-head section-head--center" data-reveal>
        <h2>Pay for changes, not pages.</h2>
        <p class="lead">Priced by how many changes you'll want.</p>
      </div>

      <div class="grid grid-3" data-reveal-group>
        {STARTUP_TIERS.map((tier) => <TierCard tier={tier} teaser reveal />)}
      </div>

      <p class="care-line" data-reveal>{maintenanceLine}</p>

      <p class="section-more section-more--center" data-reveal>
        <a class="link-arrow" href={url('/pricing')}>Full pricing and FAQ</a>
      </p>
    </div>
  </section>

  <!-- 7. Why us ------------------------------------------------------------
       One column on purpose: no team photo exists, and a placeholder for one
       would be a visible reminder that the page is unfinished.
  -->
  <section class="section">
    <div class="shell">
      <div class="why-teaser__copy" data-reveal>
        <h2>Built by our software. Checked by a person.</h2>
        <p class="lead">
          Nothing goes live until one of us has looked at it. Questions go to
          email; we reply within one business day.
        </p>
        <p class="section-more">
          <a class="link-arrow" href={url('/why-us')}>What makes us different</a>
        </p>
      </div>
    </div>
  </section>

  <!-- 8. Final CTA --------------------------------------------------------- -->
  <section class="section section--alt cta-band">
    <div class="shell-narrow" style="text-align:center" data-reveal>
      {
        BETA.on ? (
          <>
            <h2 class="cta-band__title">We're in beta. Want in?</h2>
            <p class="lead" style="margin-inline:auto">
              The first {BETA.seats} businesses get {BETA_PERCENT} off Startup. Tell us about yours.
            </p>
          </>
        ) : (
          <>
            <h2 class="cta-band__title">See your business online before you pay anything.</h2>
            <p class="lead" style="margin-inline:auto">
              Tell us about it and we'll send a free mock of your homepage.
            </p>
          </>
        )
      }
      <div class="btn-row btn-row--center" style="margin-top:var(--s-5)">
        <a class="btn btn--primary btn--lg" href={url(PRIMARY_CTA.href)}>{PRIMARY_CTA.label}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-more { margin-top: var(--s-6); }
  .section-more--center { text-align: center; }
  .section-head__link { margin-top: var(--s-3); }


  /* Hero ----------------------------------------------------------------- */

  /* Tighter at the top than a standard section: the nav is already a band of
     white above it, so a full --section-y leaves the headline floating. */
  .section--hero {
    padding-top: clamp(2.5rem, 1.6rem + 4vw, 5rem);
  }

  .hero {
    display: grid;
    gap: var(--s-6);
    align-items: center;
  }

  /* Well below --t-display's 72px, for two reasons. The headline shares the
     row with the version tree, so it never gets the full measure a
     full-width hero would; and it is now a sentence that says what we do
     rather than a three-word slogan, so it wants to be read rather than
     declaimed. At 48px it runs to three comfortable lines in this column. */
  .hero__title {
    font-size: clamp(2rem, 1.3rem + 2.4vw, 3rem);
  }

  .hero__lead {
    max-width: 34rem;
    margin-top: var(--s-4);
  }

  .hero__cta { margin-top: var(--s-5); }

  /* The beta note: one line under the buttons, the same quiet weight as
     the live-sites line below it. */
  .hero__beta {
    margin-top: var(--s-4);
    font-size: var(--t-small);
    color: var(--ink-muted);
    max-width: 30rem;
  }

  .hero__beta + .hero__live { margin-top: var(--s-2); }

  /* Quiet, and deliberately below the buttons: it is corroboration for
     someone already interested, not a competing call to action. */
  .hero__live {
    margin-top: var(--s-4);
    font-size: var(--t-small);
    color: var(--ink-muted);
    max-width: 30rem;
  }

  .hero__live a { color: var(--ink-soft); text-decoration-color: var(--line-input); }
  .hero__live a:hover { color: var(--accent); text-decoration-color: currentColor; }

  /* Capped so the stacked hero does not render the tree at 1100px wide with
     24px labels. Has no effect in the two-column layout, where the column is
     already narrower than this. */
  .hero__shot { min-width: 0; max-width: 700px; }

  .hero__caption {
    margin-top: var(--s-3);
    font-size: var(--t-small);
    color: var(--ink-muted);
    max-width: 34rem;
  }

  /* A light browser frame around a product screenshot. The chrome is the one
     place the shadow token is used — it lifts the shot off the page so it
     reads as a thing rather than a picture of one. */
  .browser {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg);
    box-shadow: var(--shadow-shot);
  }

  .browser__bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.8rem;
    background: var(--bg-alt);
    border-bottom: 1px solid var(--line);
  }

  .browser__bar > span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d2d5db;
  }

  .browser__url {
    flex: 1;
    margin-left: 0.5rem;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-sm);
    background: var(--bg);
    border: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-muted);
  }

  .cases-2up {
    display: grid;
    gap: var(--s-7);
  }

  /* How it works ---------------------------------------------------------- */

  .steps {
    display: grid;
    gap: var(--s-5);
  }

  .step {
    display: grid;
    gap: 0.4rem;
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }

  /* Numbers set in mono at body size, not in a filled circle. A numeral in a
     disc is the decoration this design is removing, and the sequence is
     already obvious from the numbers. */
  .step__num {
    font-family: var(--font-mono);
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--ink-muted);
    letter-spacing: 0.06em;
    padding-top: 0.15rem;
  }

  .step p { color: var(--ink-soft); }

  /* Platform ------------------------------------------------------------- */

  .platform-shot { margin-bottom: var(--s-6); }
  .platform-shot img { width: 100%; height: auto; }

  /* Three rows, drawing and one line each, the drawing alternating sides.
     Stacked, the words come first so the drawing has a caption to explain
     it before it starts moving. */
  .feature {
    display: grid;
    gap: var(--s-4);
    align-items: center;
    padding-block: var(--s-6);
    border-top: 1px solid var(--line);
  }

  .feature__copy { order: -1; }
  .feature__copy h3 {
    font-size: clamp(1.3rem, 1.1rem + 0.9vw, 1.75rem);
    margin-bottom: var(--s-2);
  }
  .feature__copy p { color: var(--ink-soft); }
  .feature__visual { min-width: 0; }

  .card__note { margin-top: var(--s-3); font-size: var(--t-small); }

  /* Pricing note ---------------------------------------------------------- */

  .care-line {
    margin: var(--s-5) auto 0;
    text-align: center;
    font-size: var(--t-small);
    font-weight: 550;
    color: var(--ink);
    max-width: none;
  }

  /* Final CTA ------------------------------------------------------------- */

  .cta-band__title {
    font-size: clamp(1.75rem, 1.25rem + 2.2vw, 2.6rem);
    margin-bottom: var(--s-4);
  }

  /* Two-up layouts -------------------------------------------------------- */

  @media (min-width: 860px) {
    .cases-2up { grid-template-columns: 1fr 1fr; gap: var(--s-6); }


    /* Subgrid, so the three numbers, the three headings and the three
       paragraphs each sit on a shared row. Without it a heading that wraps
       to two lines — which the third one did at several widths — pushes only
       its own paragraph down and the row stops reading as a row. Shortening
       the copy would fix today's width and break at the next one. */
    .steps {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: auto auto auto;
      gap: var(--s-4) var(--s-5);
    }

    .step {
      grid-row: span 3;
      grid-template-rows: subgrid;
      gap: 0.4rem;
    }

    .feature { grid-template-columns: 1.15fr 1fr; gap: var(--s-7); }
    .feature__copy { order: 2; }
    .feature--flip { grid-template-columns: 1fr 1.15fr; }
    .feature--flip .feature__copy { order: 1; }
    .feature--flip .feature__visual { order: 2; }

  }

  /* The hero goes two-up at 1240, much later than the 860 everything else
     uses. Below that the image column is under ~520px, and because the tree
     is an SVG its labels scale with the box — at 1100 they rendered at
     10.6px, which is the illegibility the drawn tree exists to fix. Stacked,
     the tree gets the full shell (capped above) and reads at ~14px.
     Measured across eleven widths, not guessed. */
  @media (min-width: 1240px) {
    .hero {
      /* The tree needs the wider half. Its text scales with the SVG viewBox,
         so a narrow column shrinks the labels — which is the one thing this
         hero cannot afford. The headline is a sentence at 48px and reads
         fine in the smaller half. */
      grid-template-columns: 1fr 1.25fr;
      gap: var(--s-7);
    }
  }
</style>
