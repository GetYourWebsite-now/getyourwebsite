---
/**
 * Why Us — the page a sceptical owner reads before deciding to trust us.
 *
 * The old version led with "We're high school students. That's the point."
 * That was the right opening when the pitch was sympathy and a low price.
 * It isn't now: there is a product, two live sites and a four-figure
 * entry price, and
 * leading with the founders' age invites someone to price us as a favour.
 * The fact is still here, in full, in "Who we are" — it just argues for the
 * care rather than for the discount.
 *
 * The header used to say "You talk to the people who build it". That
 * stopped being true: clients work through the portal, our software
 * generates the site, and a person reviews each change. The header now says
 * exactly that.
 *
 * Nothing on this page claims a number we cannot show. No client count
 * beyond the live sites that are linked, no testimonial (Jay's written
 * permission does not exist in the repo), no invented statistic — which is
 * the point the closing line of "Why a website at all" makes explicitly.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudy from '../components/CaseStudy.astro';
import WebsiteCompare from '../components/WebsiteCompare.astro';
import {
  BETA,
  BETA_PERCENT,
  PRIMARY_CTA,
  LIVE_SITES,
  LEGAL_NAME,
  LEGAL_STATE,
  TEAM_NAMES,
} from '../data/site.js';
import { url } from '../data/url.js';

/**
 * Four promises, each one a thing we can be held to. "No templates" went in
 * the beta rewrite — true, but saying what we build is the hero's job — and
 * the one-business-day reply moved into the header's lead.
 */
const PROMISES = [
  {
    title: 'Every version of your site is kept',
    body: 'Nothing is ever overwritten. Every revision becomes its own version, and you choose which one is live from your portal — including last year’s.',
  },
  {
    title: 'You own the site',
    body: 'Once it is paid for, the code, the content and the domain are yours. If you ever want to leave, we hand over the files and that is the end of it.',
  },
  {
    title: 'Unlimited pages',
    body: 'No page limit on any plan. You pay for how many changes you want, not for how big the site is.',
  },
  {
    title: 'A person reviews every change',
    body: 'Our software builds the site and applies your changes. One of us checks each version before it goes live — the first build and every one-line change after it.',
  },
];

/** The argument that used to be the whole of /benefits, one sentence each
    since Phase 7's word budget. */
const OUTCOMES = [
  {
    label: '01',
    title: 'More revenue',
    body: 'A site catches the demand that already exists, which tonight is going to someone else.',
  },
  {
    label: '02',
    title: 'More new clients',
    body: 'It introduces you to everyone who searches for what you do, all year round.',
  },
  {
    label: '03',
    title: 'A more streamlined day',
    body: "Every question your site answers is a phone call you don't take mid-job.",
  },
];
---

<BaseLayout
  title="Why Us"
  description="Websites for local businesses, built by our software and checked by a person before anything goes live. Every version of your site is kept, and you own what you pay for."
>
  <!-- 1. Header ---------------------------------------------------------- -->
  <section class="section section--dark section--tight">
    <div class="shell">
      <div class="section-head" data-reveal>
        <h1>Built by our software. Checked by a person.</h1>
        <p class="lead">
          Your site is generated from your real business information, and
          nothing goes live — not the first build, not a one-line change —
          until one of us has looked at it. Questions go to email; we reply
          within one business day.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. How we work ------------------------------------------------------ -->
  <section class="section">
    <div class="shell">
      <div class="section-head" data-reveal>
        <h2>Four things you can hold us to.</h2>
      </div>

      <div class="grid promises" data-reveal-group>
        {
          PROMISES.map((p) => (
            <article class="card" data-reveal>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3. Who we are ------------------------------------------------------- -->
  <section class="section section--alt">
    <div class="shell-narrow">
      <div class="section-head" data-reveal>
        <h2>Two students, one company, two live sites.</h2>
      </div>

      <div class="story" data-reveal>
        <p>
          A lot of the businesses around here aren't online — because the
          quotes were absurd, or the builder stopped answering. We decided to
          fix that, one business at a time.
        </p>
        <p>
          We live here. We walk past the businesses we build for, so we can't
          afford a bad job.
        </p>
        <p>
          And we're paying for college with this, which we'd rather say
          plainly. A client happy enough to tell someone else is the entire
          business model.
        </p>

        {TEAM_NAMES && <p class="story__names">{TEAM_NAMES}</p>}

        <p class="story__legal">{LEGAL_NAME}, {LEGAL_STATE}.</p>
      </div>
    </div>
  </section>

  <!-- 4. Why a website at all ---------------------------------------------
       The argument that used to live on /benefits. It belongs here: it is
       for the owner still deciding whether any of this is worth doing, and
       this is the page they are already on when they ask that.
  -->
  <section class="section" id="why-a-website">
    <div class="shell">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Why a website at all</p>
        <h2>Same business. Two very different weeks.</h2>
        <p class="lead">Not sure a site is worth it? Start here, not with us.</p>
      </div>

      <WebsiteCompare />

      <div class="outcomes" data-reveal-group>
        {
          OUTCOMES.map((o) => (
            <article class="outcome" data-reveal>
              <p class="outcome__label">{o.label}</p>
              <div class="outcome__body">
                <h3>{o.title}</h3>
                <p>{o.body}</p>
              </div>
            </article>
          ))
        }
      </div>

      <p class="no-numbers" data-reveal>
        <strong>We're not going to make up numbers.</strong> No statistic we
        can't trace to its source; we'd rather leave the space empty.
      </p>
    </div>
  </section>

  <!-- 5. The work ---------------------------------------------------------- -->
  <section class="section section--alt">
    <div class="shell">
      <div class="section-head" data-reveal>
        <p class="eyebrow">The work</p>
        <h2>Judge us on these.</h2>
        <p class="lead">
          One we built by hand for a client. One our platform built and hosts.
          Both are live — click through and look around.
        </p>
      </div>

      <div class="work-2up" data-reveal-group>
        {
          LIVE_SITES.map((project) => (
            <div data-reveal>
              <CaseStudy project={project} compact level={3} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. CTA ---------------------------------------------------------------- -->
  <section class="section cta-band">
    <div class="shell-narrow" style="text-align:center" data-reveal>
      {
        BETA.on ? (
          <>
            <h2 class="cta-band__title">We're in beta. Want in?</h2>
            <p class="lead" style="margin-inline:auto">
              The first {BETA.seats} businesses get {BETA_PERCENT} off Startup. Tell us about yours.
            </p>
          </>
        ) : (
          <>
            <h2 class="cta-band__title">See your business online before you pay anything.</h2>
            <p class="lead" style="margin-inline:auto">
              Tell us about it and we'll send a free mock of your homepage.
            </p>
          </>
        )
      }
      <div class="btn-row btn-row--center" style="margin-top:var(--s-5)">
        <a class="btn btn--primary btn--lg" href={url(PRIMARY_CTA.href)}>{PRIMARY_CTA.label}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Explicitly two, not .grid-2. That helper is auto-fit on a 22rem floor,
     which fits THREE columns at 1200px and left the fourth promise orphaned
     on a row of its own. Four things read as four when they are 2x2. */
  .promises { grid-template-columns: 1fr; }
  .promises .card h3 { font-size: var(--t-h3); }

  /* Who we are ------------------------------------------------------------ */

  .story p + p { margin-top: var(--s-4); }
  .story p { color: var(--ink-soft); }

  .story__names {
    margin-top: var(--s-5);
    font-weight: 550;
    color: var(--ink) !important;
  }

  .story__legal {
    margin-top: var(--s-5);
    font-size: var(--t-small);
    color: var(--ink-soft) !important;
  }

  /* Why a website at all --------------------------------------------------- */

  .outcomes {
    display: grid;
    gap: var(--s-6);
    margin-top: var(--s-7);
  }

  .outcome {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-4);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }

  .outcome__label {
    font-family: var(--font-mono);
    font-size: var(--t-small);
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    padding-top: 0.2rem;
  }

  .outcome__body h3 { margin-bottom: var(--s-2); }
  .outcome__body > p { color: var(--ink-soft); }

  .no-numbers {
    margin-top: var(--s-7);
    padding-left: var(--s-3);
    border-left: 2px solid var(--accent);
    color: var(--ink-soft);
    max-width: 44rem;
  }

  .no-numbers strong { color: var(--ink); }

  /* The work --------------------------------------------------------------- */

  .work-2up { display: grid; gap: var(--s-7); }

  .cta-band__title {
    font-size: clamp(1.75rem, 1.25rem + 2.2vw, 2.6rem);
    margin-bottom: var(--s-4);
  }

  @media (min-width: 860px) {
    .promises { grid-template-columns: 1fr 1fr; }
    .work-2up { grid-template-columns: 1fr 1fr; gap: var(--s-6); }
    .outcomes { gap: var(--s-7); }
  }
</style>
