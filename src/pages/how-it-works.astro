---
/**
 * How it works — the platform behind the sites.
 *
 * Everything on this page is checked against the shipped client portal
 * (GetYourWebsiteAdmin, `development`, the `client/` workspace) rather than
 * written from the pitch. Where a capability has a condition attached — a
 * custom domain needs the maintenance plan, only approved versions can be
 * hosted — the condition is on the page. The voice rule for this site is plain
 * and specific, and a capability with its limits stated reads as more credible
 * than one without.
 *
 * Deliberately NOT claimed here: no superlatives, no invented statistics, and
 * the only third-party figures are Cloudflare's own published ones, quoted with
 * a link so a visitor can check them. No Cloudflare logo, no implication of
 * partnership or endorsement — we are a customer of theirs, like anyone else.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../data/url.js';
import { LIVE_SITE_URL, BETA, BETA_PERCENT, PRIMARY_CTA } from '../data/site.js';
import ClickToChange from '../components/anim/ClickToChange.astro';
import PromoCode from '../components/PromoCode.astro';
import PhotoDrop from '../components/anim/PhotoDrop.astro';
import DomainConnect from '../components/anim/DomainConnect.astro';

const pagespeed = `https://pagespeed.web.dev/analysis?url=${encodeURIComponent(LIVE_SITE_URL)}`;
---

<BaseLayout
  title="How it works"
  description="Every revision is a saved version you can put live with one button. Managed hosting and domains, a build process with a human at the end of it, and your photos dragged straight onto the page."
>
  <!-- 1. Intro ---------------------------------------------------------- -->
  <section class="section section--dark section--tight">
    <div class="shell-narrow">
      <div class="section-head" data-reveal>
        <h1>A website you can actually run.</h1>
        <p class="lead">
          Most of what you pay for is the years after launch: changing it,
          hosting it, keeping it yours.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. Versions — how a change is asked for and made -------------------- -->
  <section class="section">
    <div class="shell feature">
      <div class="feature__copy" data-reveal>
        <h2>Every change is a new version.</h2>
        <p class="lead">
          Click any part of your site and say what to change. A person builds
          it and checks it; nothing is overwritten.
        </p>
      </div>
      <div class="feature__visual" data-reveal><ClickToChange /></div>
    </div>
  </section>

  <!-- 3. The one-button switch, on the real portal ------------------------ -->
  <section class="section section--alt">
    <div class="shell">
      <div class="section-head" data-reveal>
        <h2>You choose which version is live.</h2>
        <p class="lead">
          Christmas theme in November: press host. Everyday site in January:
          press host. Next November, one button again.
        </p>
      </div>

      <figure class="shot" data-reveal>
        <img
          src={url('/shots/portal-my-website.webp')}
          alt="The My website tab in the client portal, showing the live version, a list of approved versions, and Open, Quick edit, Request changes and Attach images buttons on each."
          width="1300"
          height="763"
          loading="lazy"
          decoding="async"
        />
      </figure>

      {/* The two conditions. Rule 1: a capability with its limits stated. */}
      <ul class="facts" data-reveal>
        <li>Only versions we've reviewed and approved can go live.</li>
        <li>Empty photo slots? The portal says how many before you host.</li>
      </ul>
      <p class="section-more" data-reveal>
        <a class="link-arrow" href={url('/demo')}>Try it in the demo</a>
      </p>
    </div>
  </section>

  <!-- 4. Hosting and domains --------------------------------------------- -->
  <section class="section">
    <div class="shell feature feature--flip">
      <div class="feature__copy" data-reveal>
        <h2>You never touch a registrar or DNS.</h2>
        <p class="lead">
          Search for a domain in your portal and press connect. We register it
          in your business's name.
        </p>
        <p class="feature__fine">
          Hosted on Cloudflare's network: hundreds of cities in 100+ countries,
          by their own figures.
          <a href="https://www.cloudflare.com/network/" target="_blank" rel="noopener noreferrer">Check them<span class="sr-only"> on Cloudflare's network page (opens in a new tab)</span></a>.
        </p>
        <p class="feature__fine">
          <strong>The condition:</strong> a custom domain comes with
          Maintenance, and needs your business contact details first. Without it, your
          site lives at an address we give you.
        </p>
      </div>
      <div class="feature__visual" data-reveal><DomainConnect /></div>
    </div>
  </section>

  <!-- 5. How the sites are made ------------------------------------------- -->
  <section class="section section--alt">
    <div class="shell">
      <div class="section-head" data-reveal>
        <p class="eyebrow">How they're made</p>
        <h2>It isn't one prompt into a chatbot.</h2>
        <p class="lead">Judge the process rather than our adjectives.</p>
      </div>

      <ol class="steps" data-reveal-group>
        <li data-reveal>
          <span class="steps__n" aria-hidden="true">1</span>
          <div>
            <h3>We research your business first</h3>
            <p>Your listing, your reviews and your industry, before a page is drafted.</p>
          </div>
        </li>
        <li data-reveal>
          <span class="steps__n" aria-hidden="true">2</span>
          <div>
            <h3>Built from pieces that already work</h3>
            <p>A searchable component library, ranked by a model and weighed against picks proven on other sites.</p>
          </div>
        </li>
        <li data-reveal>
          <span class="steps__n" aria-hidden="true">3</span>
          <div>
            <h3>Several passes, not one</h3>
            <p>Specialised agents draft the site, critique it and refine it.</p>
          </div>
        </li>
        <li data-reveal>
          <span class="steps__n" aria-hidden="true">4</span>
          <div>
            <h3>A person signs it off</h3>
            <p>Every site is reviewed by one of us before you see it.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- 6. Images and assets ---------------------------------------------------
       A drawing, not the portal's Assets tab: that capture is seeded with
       stock photographs, and this site shows no stock photos.
  -->
  <section class="section">
    <div class="shell feature">
      <div class="feature__copy" data-reveal>
        <p class="eyebrow">Your photos</p>
        <h2>Drag them onto the page and save.</h2>
        <p class="lead">
          Upload once, reuse across versions. We convert them to a modern
          format and host them with your site.
        </p>
      </div>
      <div class="feature__visual" data-reveal><PhotoDrop /></div>
    </div>
  </section>

  <!-- 7. Performance proof ------------------------------------------------ -->
  <section class="section section--alt">
    <div class="shell-narrow">
      <div class="section-head section-head--center" data-reveal>
        <h2>Run the test yourself.</h2>
        <p class="lead">
          Google's free page test, prefilled with this site. We print no score:
          results move between runs, and yours is worth more than ours.
        </p>
      </div>

      <ul class="scorecard" data-reveal-group>
        <li data-reveal>Performance</li>
        <li data-reveal>Accessibility</li>
        <li data-reveal>Best Practices</li>
        <li data-reveal>SEO</li>
      </ul>

      <div class="btn-row btn-row--center" data-reveal>
        <a class="btn btn--primary btn--lg" href={pagespeed} rel="noopener">
          Run the test yourself
        </a>
      </div>
    </div>
  </section>

  <!-- 8. CTA -------------------------------------------------------------- -->
  <section class="section cta-band">
    <div class="shell-narrow" style="text-align:center" data-reveal>
      <h2 class="cta-band__title">See it with your own business in it.</h2>
      <p class="lead" style="margin-inline:auto">
        {BETA.on ? (
          <>We're in beta — the first {BETA.seats} businesses get {BETA_PERCENT} off Startup with code <PromoCode />.</>
        ) : (
          "We'll build you a free mock of your homepage first. No card, no catch."
        )}
      </p>
      <div class="btn-row btn-row--center" style="margin-top:var(--s-5)">
        <a class="btn btn--primary btn--lg" href={url(PRIMARY_CTA.href)}>{PRIMARY_CTA.label}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* A section that is copy on one side and a drawing on the other. */
  .feature {
    display: grid;
    gap: var(--s-5);
    align-items: center;
  }
  .feature__visual { min-width: 0; }
  .feature__fine {
    margin-top: var(--s-3);
    font-size: var(--t-small);
    color: var(--ink-soft);
  }

  .facts {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-5);
    padding-left: 1.1rem;
    list-style: disc;
    color: var(--ink-soft);
  }
  .facts li::marker { color: var(--ink-muted); }


  @media (min-width: 900px) {
    .feature { grid-template-columns: 1fr 1.15fr; gap: var(--s-7); }
    .feature--flip { grid-template-columns: 1.15fr 1fr; }
    .feature--flip .feature__copy { order: 2; }
  }

  /* Numbered process list. The number sits in a soft accent chip so the
     sequence reads at a glance without turning into a decorative timeline. */
  .steps {
    display: grid;
    gap: var(--s-4);
    margin-top: var(--s-6);
  }

  .steps li {
    display: flex;
    gap: var(--s-4);
    align-items: flex-start;
  }

  .steps__n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    border: 1px solid var(--line);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .steps h3 { margin-bottom: var(--s-1); }

  @media (min-width: 860px) {
    .steps { grid-template-columns: 1fr 1fr; gap: var(--s-6) var(--s-7); }
  }

  /* The four Lighthouse categories, named but never scored — see the note in
     the markup for why there is no number here. */
  .scorecard {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-2);
    margin: var(--s-6) 0 var(--s-5);
  }

  .scorecard li {
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg);
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--ink-soft);
  }

</style>
