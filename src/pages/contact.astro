---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_EMAIL, FORMSPREE_FORM_ID, BETA } from '../data/site.js';
import { url } from '../data/url.js';

/**
 * The form posts to Formspree (works on static hosting, no server of ours).
 * Put your form ID in FORMSPREE_FORM_ID in src/data/site.js.
 *
 * It is a real <form> with a real action, so it still submits without
 * JavaScript — Formspree just shows its own thank-you page instead of the
 * inline success state. The script at the bottom upgrades it, posting FormData
 * with `Accept: application/json`, which is what Formspree expects.
 */
const formIsSet = FORMSPREE_FORM_ID && !FORMSPREE_FORM_ID.startsWith('REPLACE_WITH');
---

<BaseLayout
  title="Contact"
  description="Ask us about an existing site, an unusual project, or anything else. We read every inquiry and reply personally."
>
  <section class="section section--alt section--tight">
    <div class="shell">
      <div class="section-head" data-reveal>
        <h1>Get in touch.</h1>
        <p class="lead">
          {BETA.on ? (
            <>To join the beta, the fastest route is <a href={url(BETA.path)}>the beta form</a>.</>
          ) : (
            <>For a free mock, the fastest route is <a href={url('/free-mock')}>our
            free-mock form</a>.</>
          )}
          For anything else — an existing site, a quote for
          something unusual, a question — use the form below or email
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- data-reveal-now: this section is two big blocks and nothing else, so
       there is no stagger to be had from animating them in — only a window in
       which a fast scroller can arrive before they land. See reveal.js. -->
  <section class="section" data-reveal-now>
    <div class="shell contact">
      <!-- Side rail -->
      <aside class="contact__aside" data-reveal>
        <div class="note">
          <p>
            <strong>We read every inquiry and reply personally.</strong>
            Pricing is confirmed after we review your request — the mock is
            always free.
          </p>
        </div>

        <div class="direct">
          <h2 class="direct__h">Rather just email us?</h2>
          <a class="direct__mail" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
          <p class="direct__note">
            That address goes to the same place as this form. Use whichever you
            prefer.
          </p>
        </div>

        <ol class="next">
          <li><span>1</span> You send this form</li>
          <li><span>2</span> We reply within one business day</li>
          <li><span>3</span> We tell you what it would take, and what it would cost</li>
        </ol>
      </aside>

      <!-- Form -->
      <div class="contact__form" data-reveal>
        {
          !formIsSet && (
            <p class="setup-warning">
              <strong>This form isn't connected yet.</strong> Create a free
              form at formspree.io and put its ID in
              <code>FORMSPREE_FORM_ID</code> in <code>src/data/site.js</code>.
              Until then submissions fail and visitors are shown the email
              address instead, so nothing disappears silently.
            </p>
          )
        }

        <form
          id="inquiry"
          action={`https://formspree.io/f/${FORMSPREE_FORM_ID}`}
          method="POST"
          novalidate
          data-form
        >
          <input
            type="hidden"
            name="_subject"
            value="New inquiry from getyourwebsite (contact page)"
          />

          {/* Pairs with /free-mock's source=free-mock, so ad traffic and
              everything else can be told apart in the inbox. */}
          <input type="hidden" name="source" value="contact" />

          <!-- Honeypot. Hidden off-screen; bots fill it, people never see it. -->
          <div class="honeypot" aria-hidden="true">
            <label for="botcheck">Leave this field empty</label>
            <input id="botcheck" type="checkbox" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>

          <div class="fields">
            <div class="field">
              <label for="name">Your name <span class="req">*</span></label>
              <input class="input" id="name" name="name" type="text" autocomplete="name" required />
            </div>

            <div class="field">
              <label for="business">Business name <span class="req">*</span></label>
              <input class="input" id="business" name="business_name" type="text" autocomplete="organization" required />
            </div>

            <div class="field">
              <label for="type">Business type <span class="req">*</span></label>
              <input
                class="input"
                id="type"
                name="business_type"
                type="text"
                placeholder="Bakery, dentist, landscaper…"
                required
              />
            </div>

            <div class="field">
              <label for="email">Email <span class="req">*</span></label>
              <input class="input" id="email" name="email" type="email" autocomplete="email" required />
            </div>

            <div class="field">
              <label for="phone">Phone <span class="opt">optional</span></label>
              <input class="input" id="phone" name="phone" type="tel" autocomplete="tel" />
            </div>

            <div class="field">
              <label for="current">Current website <span class="opt">optional</span></label>
              <input
                class="input"
                id="current"
                name="current_website"
                type="url"
                placeholder="https://"
                inputmode="url"
              />
            </div>
          </div>

          <fieldset class="want">
            <legend class="fieldset-legend">What are you after? <span class="req">*</span></legend>
            <div class="want__opts">
              {BETA.on ? (
                <label class="radio-card">
                  <input type="radio" name="looking_for" value="Beta" required />
                  <span>
                    <strong>A place in the beta</strong>
                    <small>
                      Quicker through <a href={url(BETA.path)}>the beta form</a> —
                      it asks for less.
                    </small>
                  </span>
                </label>
              ) : (
                <label class="radio-card">
                  <input type="radio" name="looking_for" value="Free mock" required />
                  <span>
                    <strong>A free mock</strong>
                    <small>
                      Quicker through <a href={url('/free-mock')}>the free-mock form</a> —
                      it asks for less.
                    </small>
                  </span>
                </label>
              )}
              <label class="radio-card">
                <input type="radio" name="looking_for" value="Full website" />
                <span>
                  <strong>A full website</strong>
                  <small>You're ready to build the real thing.</small>
                </span>
              </label>
              <label class="radio-card">
                <input type="radio" name="looking_for" value="Something else" checked />
                <span>
                  <strong>Something else</strong>
                  <small>An existing site, an unusual project, or a question.</small>
                </span>
              </label>
            </div>
          </fieldset>

          <div class="field">
            <label for="details">Anything specific you need?</label>
            <textarea
              class="textarea"
              id="details"
              name="details"
              placeholder="A menu people can read on their phone, online booking, a gallery, somewhere to put reviews…"
            ></textarea>
            <span class="hint">The more you tell us, the closer the first mock will be.</span>
          </div>

          <div class="field">
            <label for="heard">How did you hear about us? <span class="opt">optional</span></label>
            <input class="input" id="heard" name="heard_about" type="text" />
          </div>

          <!-- Live region: screen readers announce success and errors. -->
          <p class="status" data-status role="status" aria-live="polite" hidden></p>

          <button class="btn btn--primary btn--lg submit" type="submit" data-submit>
            Send my inquiry
          </button>

          <p class="small-print">
            We'll only use this to reply to you and make your mock. No list, no
            newsletter, never sold. See our <a href={url('/privacy')}>Privacy Policy</a>.
          </p>
        </form>

        <!-- Shown in place of the form after a successful send. -->
        <div class="done" data-done hidden>
          <div class="done__mark" aria-hidden="true">✓</div>
          <h2>That's with us.</h2>
          <p>
            Thanks — we've got your inquiry and we'll reply personally within
            one business day. If it's urgent, email us directly at
            <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
          </p>
          <div class="btn-row" style="margin-top:var(--s-4)">
            <a class="btn btn--secondary" href={url('/work')}>See our work while you wait</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    gap: var(--s-6);
    align-items: start;
  }

  /* Aside ----------------------------------------------------------------- */

  .note {
    padding: var(--s-4);
    border-left: 2px solid var(--accent);
    background: var(--accent-soft);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .note strong { display: block; margin-bottom: 0.3rem; }
  .note p { color: var(--ink-soft); font-size: 0.98rem; }
  .note strong { color: var(--ink); }

  .direct { margin-top: var(--s-5); }

  .direct__h {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: var(--s-2);
  }

  .direct__mail {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--accent);
    word-break: break-all;
  }

  .direct__note {
    margin-top: var(--s-2);
    font-size: var(--t-small);
    color: var(--ink-soft);
  }

  .next {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-top: var(--s-5);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }

  .next li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .next span {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  /* Form ------------------------------------------------------------------ */

  .setup-warning {
    padding: var(--s-3) var(--s-4);
    margin-bottom: var(--s-4);
    border: 1px dashed var(--accent);
    border-radius: var(--radius);
    background: var(--accent-soft);
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .setup-warning code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: rgba(10, 10, 12, 0.06);
    padding: 0.05em 0.35em;
    border-radius: 4px;
  }

  .fields {
    display: grid;
    gap: var(--s-4);
  }

  .req { color: var(--accent); }

  .opt {
    font-weight: 400;
    color: var(--ink-soft);
    font-size: 0.85em;
  }

  .want {
    border: 0;
    margin-top: var(--s-5);
  }

  .want__opts {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-3);
  }

  .radio-card span { display: block; }
  .radio-card strong { display: block; font-size: 0.98rem; }

  .radio-card small {
    display: block;
    color: var(--ink-soft);
    font-size: var(--t-small);
    line-height: 1.45;
  }

  .contact__form .field + .field,
  .want + .field { margin-top: var(--s-4); }

  /* …except inside .fields, which is a grid and already spaces its children
     with `gap`. The margin there stacked on top of the gap and, because the
     first field has no preceding sibling to trigger it, pushed every other
     field in the row down by 24px — so the two columns of the first row sat
     on different baselines. Pre-existing; it only became obvious once the
     field borders were dark enough to see. */
  .fields > .field + .field { margin-top: 0; }

  .status {
    margin-top: var(--s-4);
    padding: var(--s-3) var(--s-4);
    border-radius: var(--radius);
    font-size: 0.95rem;
  }

  .status[data-state='error'] {
    background: #fdf0ef;
    border: 1px solid #d9b0ac;
    color: #8c241b;
  }

  .status[data-state='sending'] {
    background: var(--ink-soft);
    border: 1px solid var(--line);
    color: var(--ink-soft);
  }

  .submit { margin-top: var(--s-4); width: 100%; }

  .small-print {
    margin-top: var(--s-3);
    font-size: var(--t-small);
    color: var(--ink-soft);
    text-align: center;
  }

  /* Success ---------------------------------------------------------------- */

  .done {
    padding: var(--s-6) var(--s-5);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    background: var(--accent-soft);
    text-align: center;
  }

  .done[hidden] { display: none; }

  .done__mark {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    margin: 0 auto var(--s-4);
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 1.6rem;
    font-weight: 700;
  }

  .done h2 { margin-bottom: var(--s-3); }
  .done p { color: var(--ink-soft); max-width: 34rem; margin-inline: auto; }
  .done a { color: var(--accent); font-weight: 600; }
  .done .btn-row { justify-content: center; }

  @media (min-width: 700px) {
    .fields { grid-template-columns: 1fr 1fr; }
  }

  @media (min-width: 960px) {
    .contact { grid-template-columns: 0.8fr 1.2fr; gap: var(--s-8); }
    .contact__aside { position: sticky; top: 110px; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  const status = document.querySelector<HTMLElement>('[data-status]');
  const done = document.querySelector<HTMLElement>('[data-done]');
  const submit = document.querySelector<HTMLButtonElement>('[data-submit]');

  if (form && status && done && submit) {
    /** Show a message in the live region. */
    const say = (text: string, state: 'sending' | 'error') => {
      status.textContent = text;
      status.dataset.state = state;
      status.hidden = false;
    };

    /**
     * Validate in the browser first so people get errors next to the field
     * rather than after a round trip. Returns the first invalid element.
     */
    function firstInvalid(): HTMLInputElement | HTMLTextAreaElement | null {
      const controls = form!.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
        'input:not([type=hidden]), textarea'
      );

      for (const el of controls) {
        el.removeAttribute('aria-invalid');
      }

      for (const el of controls) {
        if (!el.checkValidity()) {
          el.setAttribute('aria-invalid', 'true');
          return el;
        }
      }
      return null;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const bad = firstInvalid();
      if (bad) {
        say(bad.validationMessage || 'Please check the highlighted field.', 'error');
        bad.focus();
        return;
      }

      submit.disabled = true;
      const originalLabel = submit.textContent;
      submit.textContent = 'Sending…';
      say('Sending your inquiry…', 'sending');

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const data = await res.json().catch(() => ({}));

        if (!res.ok || data.success === false) {
          throw new Error(data.message || `Request failed (${res.status})`);
        }

        // Swap the form out for the confirmation and move focus to it so
        // screen reader and keyboard users land in the right place.
        form.hidden = true;
        status.hidden = true;
        done.hidden = false;
        done.setAttribute('tabindex', '-1');
        done.focus();
        done.scrollIntoView({ block: 'center', behavior: 'smooth' });
      } catch (err) {
        say(
          `Sorry — that didn't send (${
            err instanceof Error ? err.message : 'unknown error'
          }). Please email us directly and we'll pick it up straight away.`,
          'error'
        );
        submit.disabled = false;
        submit.textContent = originalLabel;
      }
    });

    // Clear the invalid flag as soon as someone starts fixing a field.
    form.addEventListener('input', (e) => {
      (e.target as HTMLElement).removeAttribute('aria-invalid');
    });
  }
</script>
