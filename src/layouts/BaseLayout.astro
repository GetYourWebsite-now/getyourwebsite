---
/**
 * The shell every page uses: <head>, nav, <main>, footer.
 *
 * Pass a title and description on every page — they're the SEO basics and
 * there is no sensible default for them.
 */
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BareHeader from '../components/BareHeader.astro';
import BareFooter from '../components/BareFooter.astro';
import { url } from '../data/url.js';
import { HEADING_FONT, GOATCOUNTER_ID } from '../data/site.js';

/**
 * The self-hosted heading faces. See HEADING_FONT in src/data/site.js — that
 * one line is the switch; nothing here needs editing to change fonts.
 *
 * Each is a variable font, so one file covers every weight the headings use.
 */
const HEADING_FACES = {
  // The default. Inter is also the body face: headings are separated by size,
  // weight and the optical-size axis rather than by being a different family,
  // which is where the restraint in this design comes from. No preload entry
  // is needed because the body face is preloaded for every page anyway.
  inter: { family: 'Inter', file: null, track: '-0.025em' },

  // Kept selectable for comparison only — `node tools/font-compare.mjs`.
  // `track` overrides --h-track: a wider face has to be set tighter to hold
  // the same line counts. These two values are a pair and have to be tuned
  // together, because opening the word gaps widens every line.
  clash: {
    family: 'Clash Display',
    file: 'ClashDisplay-Variable.woff2',
    track: '-0.055em',
    word: '0.08em',
  },
  cabinet: { family: 'Cabinet Grotesk', file: 'CabinetGrotesk-Variable.woff2' },
  sora: { family: 'Sora', file: 'Sora-Variable.woff2' },
};

const headingFace = HEADING_FACES[HEADING_FONT];

interface Props {
  title: string;
  description: string;
  /**
   * Landing-page chrome: logo only, no nav, and a footer with nothing but
   * the legal links. For pages that paid traffic lands on, where every
   * other link is a way out.
   */
  bare?: boolean;
  /** Keep the page out of search. Ads traffic only. */
  noindex?: boolean;
}

const { title, description, bare = false, noindex = false } = Astro.props;

const fullTitle = title === 'GetYourWebsite'
  ? 'GetYourWebsite — websites for local businesses'
  : `${title} · GetYourWebsite`;

// Astro.site comes from SITE_URL in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com');
const ogImage = new URL(url('/og.png'), Astro.site ?? 'https://example.com');

---

<!doctype html>
<!-- data-base lets client-side scripts build URLs that work whether the site
     is served from / or from /getyourwebsite/. -->
<html lang="en" class="no-js" data-base={import.meta.env.BASE_URL}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Social card -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GetYourWebsite" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />

    <!-- Fonts. Both self-hosted, so there is no third-party connection to
         open before text can be styled: no preconnect, no render-blocking
         stylesheet from a CDN, nothing for a visitor to be tracked by.

         Inter is preloaded because it is the body face and on the critical
         path for every page; JetBrains Mono is not, because it only sets
         eyebrows and figures and @font-face is lazy, so it is fetched in
         parallel the moment something uses it. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href={url('/fonts/Inter-Variable.woff2')}
    />

    <!-- An alternate heading face, if HEADING_FONT selects one. Inter needs
         nothing here: it is already preloaded above and already the default
         value of --font-display. -->
    {
      headingFace?.file && (
        <>
          <link
            rel="preload"
            as="font"
            type="font/woff2"
            crossorigin
            href={url(`/fonts/${headingFace.file}`)}
          />
          {/* html:root, not :root. Astro's stylesheet link lands after this
              inline block, so at equal specificity global.css would win the
              cascade and the override would silently do nothing. The extra
              element selector outranks it wherever it sits. */}
          <style
            set:html={
              `html:root{--font-display:'${headingFace.family}','Inter',system-ui,-apple-system,sans-serif` +
              (headingFace.track ? `;--h-track:${headingFace.track}` : '') +
              (headingFace.word ? `;--h-word:${headingFace.word}` : '') +
              `}`
            }
          />
        </>
      )
    }

    <!-- Analytics, only if a site code is set. Emitting the tag with an empty
         code would request a dead endpoint on every page load and cost a
         request for nothing, so an unset placeholder ships no script at all. -->
    {
      GOATCOUNTER_ID && (
        <script
          defer
          data-goatcounter={`https://${GOATCOUNTER_ID}.goatcounter.com/count`}
          src="//gc.zgo.at/count.js"
        />
      )
    }

    <!-- Swap .no-js for .js before first paint so [data-reveal] elements are
         hidden only when JS can actually reveal them again. -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    {bare ? <BareHeader /> : <Nav />}

    <main id="main">
      <slot />
    </main>

    {bare ? <BareFooter /> : <Footer />}

    <script>
      import '../scripts/reveal.js';
    </script>
  </body>
</html>
