---
/**
 * The positioning section: the two ways people usually get a website, and
 * where we sit between them.
 *
 * Left, the do-it-yourself builders; right, the agencies. Lines run from both
 * into the centre, where our mark draws itself in — the hexagon's outline
 * first, then the fill, then the two pages.
 *
 * The names on either side are plain text in our own type. No logos, no brand
 * colours, and no claim about any of them beyond the one line under each
 * heading — the comparison is about who does the work, not about whose
 * product is better.
 *
 * The price is read from BUILD_TIERS, the one place prices live.
 *
 * 7s loop. The base styles are the final frame (see anim.css).
 */
import './anim.css';
import { BUILD_TIERS } from '../../data/site.js';

const from = BUILD_TIERS[0].price;

// Where the lines start, on the centre drawing's left and right edges, and
// where they meet the mark.
const LEFT = [36, 76, 124, 164];
const RIGHT = [72, 128];
const left = LEFT.map((y) => `M0 ${y} C64 ${y} 72 100 124 100`);
const right = RIGHT.map((y) => `M320 ${y} C256 ${y} 248 100 196 100`);
---

<div class="merge">
  <div class="merge__side merge__side--diy">
    <ul class="merge__names" aria-label="Website builders">
      <li>Squarespace</li><li>Wix</li><li>Base44</li><li>Replit</li>
    </ul>
    <h3>You do the work</h3>
    <p>Templates and prompts. Nights and weekends. Yours to maintain.</p>
  </div>

  <div class="merge__centre">
    <figure class="anim anim--bare merge__fig" data-anim>
      <svg viewBox="0 0 320 200" role="presentation" aria-hidden="true" focusable="false">
        {[...left, ...right].map((d, i) => (
          <path class="merge__line" d={d} pathLength="1" style={`--i:${i}`}></path>
        ))}
        <g transform="translate(128 68)">
          <path class="merge__hex" d="M32 2 L58 17 L58 47 L32 62 L6 47 L6 17 Z" pathLength="1"></path>
          <rect class="merge__page" x="18" y="18" width="18" height="18"></rect>
          <rect class="merge__page merge__page--2" x="28" y="28" width="18" height="18"></rect>
        </g>
      </svg>
    </figure>
    <h3>Done for you. Without the agency bill.</h3>
    <p>Built, hosted and kept current by people you can email. From {from}.</p>
  </div>

  <div class="merge__side merge__side--agency">
    <ul class="merge__names" aria-label="Agencies">
      <li>Design studios</li><li>Marketing agencies</li>
    </ul>
    <h3>They do the work</h3>
    <p>Done for you, at agency prices and agency timelines.</p>
  </div>
</div>

<style>
  .merge {
    display: grid;
    gap: var(--s-6);
    text-align: center;
  }

  /* Stacked: the two familiar options, then the answer. */
  .merge__side--diy { order: 1; }
  .merge__side--agency { order: 2; }
  .merge__centre { order: 3; }

  .merge h3 { font-size: var(--t-h3); margin-top: var(--s-3); }
  .merge p { color: var(--ink-soft); margin: var(--s-2) auto 0; max-width: 22rem; }
  .merge__centre h3 { font-size: clamp(1.3rem, 1.1rem + 0.9vw, 1.75rem); }
  .merge__centre p { color: var(--ink); }

  .merge__names {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1rem;
    list-style: none;
    padding: 0;
    color: var(--ink-muted);
    font-size: var(--t-small);
  }

  .merge__fig {
    margin: 0;
    max-width: 360px;
    margin-inline: auto;
  }

  .merge__fig svg { display: block; width: 100%; height: auto; overflow: visible; }

  @media (min-width: 900px) {
    .merge {
      grid-template-columns: 1fr 1.4fr 1fr;
      align-items: center;
      gap: var(--s-4);
    }
    .merge__side--diy { order: 1; text-align: right; }
    .merge__centre { order: 2; }
    .merge__side--agency { order: 3; text-align: left; }
    .merge__side p { margin-inline: 0; }
    .merge__side--diy p { margin-left: auto; }
    .merge__names { flex-direction: column; gap: 0.35rem; }
    .merge__side--diy .merge__names { align-items: flex-end; }
    .merge__side--agency .merge__names { align-items: flex-start; }
  }

  /* Drawing: final frame is everything drawn. */
  .merge__line { fill: none; stroke: var(--line-input); stroke-width: 1.25; stroke-linecap: round; stroke-dasharray: 1; }
  .merge__hex { fill: var(--accent); stroke: var(--accent); stroke-width: 2; stroke-dasharray: 1; stroke-linejoin: round; }
  .merge__page { fill: var(--bg); }

  .merge__fig * { animation-duration: 7s; animation-iteration-count: infinite; animation-timing-function: var(--ease); animation-fill-mode: both; }

  .merge__line { animation-name: merge-line; animation-delay: calc(var(--i) * 0.08s); }
  .merge__hex { animation-name: merge-hex; }
  .merge__page { animation-name: merge-page; }
  .merge__page--2 { animation-name: merge-page-2; }

  /* Lines draw in 0.3–2.2s, the outline 2.2–3.5s, fill 3.5s, pages 3.9s and
     4.2s, hold to 6.3s, then everything clears for the next pass. */
  @keyframes merge-line {
    0%, 4%    { stroke-dashoffset: 1; opacity: 1; }
    30%, 90%  { stroke-dashoffset: 0; opacity: 1; }
    97%, 100% { stroke-dashoffset: 0; opacity: 0; }
  }
  @keyframes merge-hex {
    0%, 30%   { stroke-dashoffset: 1; fill-opacity: 0; opacity: 1; }
    48%       { stroke-dashoffset: 0; fill-opacity: 0; opacity: 1; }
    54%, 90%  { stroke-dashoffset: 0; fill-opacity: 1; opacity: 1; }
    97%, 100% { stroke-dashoffset: 0; fill-opacity: 1; opacity: 0; }
  }
  @keyframes merge-page {
    0%, 54%   { opacity: 0; }
    59%, 90%  { opacity: 1; }
    97%, 100% { opacity: 0; }
  }
  @keyframes merge-page-2 {
    0%, 58%   { opacity: 0; }
    63%, 90%  { opacity: 1; }
    97%, 100% { opacity: 0; }
  }
</style>

<script>
  import '../../scripts/anim.js';
</script>
