---
/**
 * A photo dragged from the client's library onto an empty slot on their page.
 *
 * The portal's attach-images panel, drawn: the page's photo slots on one
 * side, the client's own library on the other. A tile is picked up, the slot
 * highlights as it passes over (the panel's is-over state), it drops, and
 * "Save photos" — the panel's real button label — saves it.
 *
 * The photos are drawn shapes, not photographs: no stock imagery anywhere on
 * the site, and a drawing of a photo cannot be mistaken for a client's.
 *
 * 7s loop. The base styles are the final frame (see anim.css).
 */
import './anim.css';

interface Props {
  label?: string;
}
const {
  label = 'Drag one of your own photos from your library onto an empty photo slot on your site, then save.',
} = Astro.props;

/** A drawn photo: a well with a hill and a sun, at any size. */
const photo = (x: number, y: number, w: number, h: number) => ({
  x, y, w, h,
  hill: `M${x + w * 0.08} ${y + h * 0.9} L${x + w * 0.38} ${y + h * 0.45} L${x + w * 0.58} ${y + h * 0.7} L${x + w * 0.72} ${y + h * 0.55} L${x + w * 0.94} ${y + h * 0.9} Z`,
  sun: { cx: x + w * 0.76, cy: y + h * 0.3, r: Math.min(w, h) * 0.12 },
});

const tiles = [
  photo(274, 50, 50, 40),
  photo(332, 50, 50, 40),
  photo(274, 98, 50, 40),
  photo(332, 98, 50, 40),
];
const slot = photo(26, 96, 196, 96);
---

<figure class="anim pd" data-anim>
  <svg viewBox="0 0 400 260" role="presentation" aria-hidden="true" focusable="false">
    <!-- The client's page -->
    <rect class="a-card" x="8" y="8" width="246" height="244" rx="8"></rect>
    <circle class="a-dot" cx="22" cy="21" r="3"></circle>
    <circle class="a-dot" cx="32" cy="21" r="3"></circle>
    <circle class="a-dot" cx="42" cy="21" r="3"></circle>
    <line x1="8" y1="34" x2="254" y2="34" stroke="var(--line)"></line>
    <text class="a-h" x="26" y="64">Rosa's Bakery</text>
    <rect class="a-skel" x="26" y="76" width="150" height="6" rx="3"></rect>

    <!-- The slot: empty, then filled -->
    <g class="pd__empty">
      <rect class="pd__slot" x={slot.x} y={slot.y} width={slot.w} height={slot.h} rx="6"></rect>
      <text class="a-m" x={slot.x + slot.w / 2} y={slot.y + slot.h / 2 + 4} text-anchor="middle">Photo slot</text>
    </g>
    <rect class="pd__over" x={slot.x} y={slot.y} width={slot.w} height={slot.h} rx="6"></rect>
    <g class="pd__filled">
      <rect x={slot.x} y={slot.y} width={slot.w} height={slot.h} rx="6" fill="var(--accent-soft)" stroke="var(--accent)"></rect>
      <path d={slot.hill} fill="var(--accent)" opacity="0.45"></path>
      <circle cx={slot.sun.cx} cy={slot.sun.cy} r={slot.sun.r} fill="var(--accent)" opacity="0.45"></circle>
    </g>
    <rect class="a-skel" x="26" y="206" width="196" height="6" rx="3"></rect>
    <rect class="a-skel" x="26" y="218" width="120" height="6" rx="3"></rect>

    <g class="pd__saved">
      <rect class="a-chip" x="164" y="50" width="70" height="20" rx="10"></rect>
      <path d="M177 60 L181 64 L188 56" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
      <text class="a-chip-t" x="193" y="64">Saved</text>
    </g>

    <!-- The library -->
    <rect class="a-card" x="264" y="8" width="128" height="244" rx="8"></rect>
    <text class="a-label" x="276" y="36">Your photos</text>
    {tiles.map((t) => (
      <g>
        <rect x={t.x} y={t.y} width={t.w} height={t.h} rx="4" fill="var(--bg-alt)" stroke="var(--line)"></rect>
        <path d={t.hill} fill="var(--line-input)" opacity="0.5"></path>
        <circle cx={t.sun.cx} cy={t.sun.cy} r={t.sun.r} fill="var(--line-input)" opacity="0.5"></circle>
      </g>
    ))}
    <rect class="a-skel" x="276" y="156" width="96" height="6" rx="3"></rect>
    <rect class="a-skel" x="276" y="168" width="70" height="6" rx="3"></rect>
    <rect class="a-btn" x="276" y="214" width="104" height="26" rx="5"></rect>
    <text class="a-btn-t" x="328" y="231">Save photos</text>

    <!-- The tile in flight, and the pointer carrying it -->
    <g class="pd__ghost">
      <rect x="-25" y="-20" width="50" height="40" rx="4" fill="var(--bg)" stroke="var(--accent)" stroke-width="1.5"></rect>
      <path d="M-21 16 L-6 -2 L4 8 L11 2 L22 16 Z" fill="var(--accent)" opacity="0.45"></path>
      <circle cx="13" cy="-8" r="4.8" fill="var(--accent)" opacity="0.45"></circle>
    </g>
    <circle class="a-ring pd__ring" cx="328" cy="227" r="14"></circle>
    <path class="a-cursor pd__cursor" d="M0 0 L0 17 L4.6 12.6 L7.6 19.4 L10.4 18.2 L7.4 11.6 L13.4 11.6 Z"></path>
  </svg>
  <figcaption class="sr-only">{label}</figcaption>
</figure>

<style>
  .pd__slot { fill: var(--bg-alt); stroke: var(--line-input); stroke-dasharray: 5 4; }
  .pd__over { fill: none; stroke: var(--accent); stroke-width: 2; stroke-dasharray: 5 4; }

  /* Final frame: filled and saved. */
  .pd__empty, .pd__over, .pd__ghost, .pd__cursor, .pd__ring { opacity: 0; }
  .pd__ring { transform-box: fill-box; transform-origin: center; }

  .pd * { animation-duration: 7s; animation-iteration-count: infinite; animation-timing-function: var(--ease); animation-fill-mode: both; }

  .pd__empty  { animation-name: pd-empty; }
  .pd__over   { animation-name: pd-over; }
  .pd__filled { animation-name: pd-filled; }
  .pd__ghost  { animation-name: pd-ghost; }
  .pd__cursor { animation-name: pd-cursor; }
  .pd__ring   { animation-name: pd-ring; }
  .pd__saved  { animation-name: pd-saved; }

  /* Pick up at 1.3s, carry to the slot by 2.8s, drop at 2.9s, press Save at
     4s, "Saved" at 4.2s, hold to 6.4s. */
  @keyframes pd-cursor {
    0%, 6%    { opacity: 0; transform: translate(352px, 196px); }
    10%       { opacity: 1; transform: translate(352px, 196px); }
    18%, 20%  { opacity: 1; transform: translate(299px, 70px); }
    40%, 42%  { opacity: 1; transform: translate(124px, 144px); }
    54%, 60%  { opacity: 1; transform: translate(328px, 227px); }
    66%, 100% { opacity: 0; transform: translate(328px, 227px); }
  }
  @keyframes pd-ghost {
    0%, 18%   { opacity: 0; transform: translate(299px, 70px); }
    20%       { opacity: 1; transform: translate(299px, 70px); }
    40%       { opacity: 1; transform: translate(124px, 144px); }
    43%, 100% { opacity: 0; transform: translate(124px, 144px); }
  }
  @keyframes pd-over {
    0%, 33%   { opacity: 0; }
    35%, 41%  { opacity: 1; }
    43%, 100% { opacity: 0; }
  }
  /* The empty slot gives way to the highlighted one while the tile is
     over it, so the label does not show round the tile's edges. */
  @keyframes pd-empty {
    0%, 32%   { opacity: 1; }
    35%, 93%  { opacity: 0; }
    98%, 100% { opacity: 1; }
  }
  @keyframes pd-filled {
    0%, 41%   { opacity: 0; }
    44%, 92%  { opacity: 1; }
    97%, 100% { opacity: 0; }
  }
  @keyframes pd-ring {
    0%, 56%   { opacity: 0; transform: scale(0.4); }
    57%       { opacity: 1; transform: scale(0.6); }
    62%, 100% { opacity: 0; transform: scale(1.3); }
  }
  @keyframes pd-saved {
    0%, 59%   { opacity: 0; transform: translateY(4px); }
    62%, 92%  { opacity: 1; transform: none; }
    97%, 100% { opacity: 0; transform: none; }
  }
</style>

<script>
  import '../../scripts/anim.js';
</script>
