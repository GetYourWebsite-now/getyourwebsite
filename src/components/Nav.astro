---
/**
 * Sticky site navigation. White, one hairline bottom border, no blur.
 *
 * Solid on every page including the home page: there is no longer a dark
 * hero for it to float over.
 */
import { BETA, NAV_LINKS, PORTAL_URL, PRIMARY_CTA, SIGNUP_COUNT_URL } from '../data/site.js';
import { url, isActive } from '../data/url.js';
import Wordmark from './Wordmark.astro';

const here = Astro.url.pathname;
---

<header class="nav" data-nav>
  <a class="skip-link" href="#main">Skip to content</a>

  {
    BETA.on && (
      <>
        <a class="seat-banner" href={url(BETA.path)}>
          <span class="seat-banner__n" data-signup-count></span> / <span class="seat-banner__n">{BETA.seats}</span> have signed up for the beta
        </a>
        <script is:inline define:vars={{ signupUrl: SIGNUP_COUNT_URL }}>
          (function () {
            var KEY = 'gyw-signups';
            var FAIL = 'gyw-signups-fail';
            var HOUR = 60 * 60 * 1000;
            var el = document.querySelector('[data-signup-count]');
            var banner = el && el.closest('.seat-banner');
            if (!el || !banner) return;

            function valid(n) {
              return typeof n === 'number' && Number.isInteger(n) && n >= 0;
            }
            function show(n) {
              if (!valid(n)) return;
              el.textContent = String(n);
              banner.classList.add('is-ready');
            }
            function read() {
              try {
                var data = JSON.parse(localStorage.getItem(KEY) || '');
                if (!data || !valid(data.count) || typeof data.at !== 'number') return null;
                return data;
              } catch (e) {
                return null;
              }
            }

            var cached = read();
            if (cached) show(cached.count);
            if (cached && Date.now() - cached.at < HOUR) return;
            try {
              if (sessionStorage.getItem(FAIL)) return;
            } catch (e) {}

            fetch(signupUrl)
              .then(function (res) {
                if (!res.ok) throw new Error('signup count');
                return res.json();
              })
              .then(function (body) {
                if (!body || !valid(body.count)) throw new Error('signup count');
                try {
                  localStorage.setItem(KEY, JSON.stringify({ count: body.count, at: Date.now() }));
                } catch (e) {}
                show(body.count);
              })
              .catch(function () {
                try { sessionStorage.setItem(FAIL, '1'); } catch (e) {}
              });
          })();
        </script>
      </>
    )
  }

  <div class="nav__inner shell">
    <a class="nav__brand" href={url('/')} aria-label="GetYourWebsite — home">
      <Wordmark />
    </a>

    <nav class="nav__links" aria-label="Main">
      {
        NAV_LINKS.map((link) => (
          <a
            href={url(link.href)}
            class="nav__link"
            aria-current={isActive(here, link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    {
      PORTAL_URL && (
        <a class="nav__signin" href={PORTAL_URL} rel="noopener">
          Sign in
        </a>
      )
    }

    <a class="btn btn--primary btn--sm nav__cta" href={url(PRIMARY_CTA.href)}>{PRIMARY_CTA.label}</a>

    <button
      class="nav__burger"
      type="button"
      aria-expanded="false"
      aria-controls="nav-drawer"
      data-burger
    >
      <span class="sr-only">Open menu</span>
      <span class="nav__burger-bar" aria-hidden="true"></span>
      <span class="nav__burger-bar" aria-hidden="true"></span>
    </button>
  </div>

  <!-- Mobile drawer. Hidden from assistive tech and keyboard until opened. -->
  <div class="nav__drawer" id="nav-drawer" data-drawer hidden>
    <nav class="nav__drawer-links" aria-label="Mobile">
      {
        NAV_LINKS.map((link) => (
          <a
            href={url(link.href)}
            aria-current={isActive(here, link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a class="btn btn--primary nav__drawer-cta" href={url(PRIMARY_CTA.href)}>{PRIMARY_CTA.label}</a>
      {/* Below the CTA on purpose: findable, and out of the way of the thing we
          actually want a first-time visitor to press. */}
      {PORTAL_URL && (
        <a class="nav__drawer-signin" href={PORTAL_URL} rel="noopener">
          Sign in
        </a>
      )}
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  /* Seat count. Hidden until the script has a number, so a failed
     request never paints a made-up zero. Tabular nums on the figures
     only — tnum on the whole line widens the slash. */
  .seat-banner:not(.is-ready) { display: none; }

  .seat-banner {
    display: block;
    background: var(--bg-alt);
    color: var(--ink);
    border-bottom: 1px solid var(--line);
    padding: 0.55rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
    text-align: center;
    text-decoration: none;
  }

  .seat-banner:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .seat-banner__n {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    min-height: 68px;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    margin-right: auto;
  }

  .nav__links {
    display: none;
    align-items: center;
    gap: 0.15rem;
  }

  .nav__link {
    position: relative;
    padding: 0.5rem 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
  }

  .nav__link:hover {
    color: var(--ink);
    background: var(--bg-alt);
  }

  /* The current page is marked by ink weight, not by the accent — the accent
     belongs to the CTA, and a coloured nav link competes with it. */
  .nav__link[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }

  /* Sign in. Deliberately quiet and set apart from the main link group: the
     CTA is the primary action and this must not compete with it. Clients
     arrive here knowing they have an account, so it only has to be findable. */
  .nav__signin {
    display: none;
    align-items: center;
    margin-left: 0.5rem;
    padding: 0.5rem 0 0.5rem 1.25rem;
    border-left: 1px solid var(--line);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur) var(--ease);
  }

  .nav__signin:hover { color: var(--ink); }

  .nav__cta { display: none; margin-left: 0.75rem; }

  /* Burger ---------------------------------------------------------------- */

  .nav__burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0 10px;
    border-radius: var(--radius-sm);
    transition: background var(--dur) var(--ease);
  }

  .nav__burger:hover { background: var(--bg-alt); }

  .nav__burger-bar {
    display: block;
    width: 100%;
    height: 1.5px;
    background: var(--ink);
    transition: transform var(--dur) var(--ease);
  }

  .nav__burger[aria-expanded='true'] .nav__burger-bar:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .nav__burger[aria-expanded='true'] .nav__burger-bar:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* Drawer ---------------------------------------------------------------- */

  .nav__drawer {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .nav__drawer[hidden] { display: none; }

  .nav__drawer-links {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: min(100% - 2.5rem, var(--shell));
    margin-inline: auto;
    padding-block: var(--s-2) var(--s-5);
  }

  .nav__drawer-links a {
    padding: 0.9rem 0.25rem;
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .nav__drawer-links a[aria-current='page'] { font-weight: 600; }

  .nav__drawer-cta {
    margin-top: var(--s-4);
    border-bottom: 0 !important;
    color: #fff !important;
    justify-content: center;
  }

  .nav__drawer-signin {
    margin-top: var(--s-3);
    text-align: center;
    border-bottom: 0 !important;
    font-size: 0.9375rem;
    color: var(--ink-soft) !important;
    font-weight: 500 !important;
  }

  /* Desktop --------------------------------------------------------------- */

  /* 1060, not 900. The desktop row carries the page links, Sign in and the
     CTA. Below this the drawer holds everything comfortably. */
  @media (min-width: 1060px) {
    .nav__signin { display: inline-flex; }

    .nav__links,
    .nav__cta { display: flex; }
    .nav__burger { display: none; }
    .nav__drawer { display: none !important; }
  }

</style>

<script>
  // --- Mobile drawer -------------------------------------------------------
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');

  if (burger && drawer) {
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      drawer.hidden = !open;
      burger.querySelector('.sr-only')!.textContent = open ? 'Close menu' : 'Open menu';
    };

    burger.addEventListener('click', () => {
      setOpen(burger.getAttribute('aria-expanded') !== 'true');
    });

    // Escape closes the drawer and returns focus to the button.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        burger.focus();
      }
    });

    // Close if the viewport grows past the desktop breakpoint while open.
    const mq = window.matchMedia('(min-width: 900px)');
    mq.addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>
