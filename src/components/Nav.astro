---
/**
 * Sticky site navigation. White, one hairline bottom border, no blur.
 *
 * Solid on every page including the home page: there is no longer a dark
 * hero for it to float over.
 */
import { NAV_LINKS, PORTAL_URL, PRIMARY_CTA } from '../data/site.js';
import { url, isActive } from '../data/url.js';
import Wordmark from './Wordmark.astro';

const here = Astro.url.pathname;
---

<header class="nav" data-nav>
  <a class="skip-link" href="#main">Skip to content</a>

  <div class="nav__inner shell">
    <a class="nav__brand" href={url('/')} aria-label="GetYourWebsite — home">
      <Wordmark />
    </a>

    <nav class="nav__links" aria-label="Main">
      {
        NAV_LINKS.map((link) => (
          <a
            href={url(link.href)}
            class="nav__link"
            aria-current={isActive(here, link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    {
      PORTAL_URL && (
        <a class="nav__signin" href={PORTAL_URL} rel="noopener">
          Sign in
        </a>
      )
    }

    <a class="btn btn--primary btn--sm nav__cta" href={url(PRIMARY_CTA.href)}>{PRIMARY_CTA.label}</a>

    <button
      class="nav__burger"
      type="button"
      aria-expanded="false"
      aria-controls="nav-drawer"
      data-burger
    >
      <span class="sr-only">Open menu</span>
      <span class="nav__burger-bar" aria-hidden="true"></span>
      <span class="nav__burger-bar" aria-hidden="true"></span>
    </button>
  </div>

  <!-- Mobile drawer. Hidden from assistive tech and keyboard until opened. -->
  <div class="nav__drawer" id="nav-drawer" data-drawer hidden>
    <nav class="nav__drawer-links" aria-label="Mobile">
      {
        NAV_LINKS.map((link) => (
          <a
            href={url(link.href)}
            aria-current={isActive(here, link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      {/* Demo is out of the desktop bar but belongs in the drawer: on a
          phone this list is the whole site. */}
      <a href={url('/demo')} aria-current={isActive(here, '/demo') ? 'page' : undefined}>
        Demo
      </a>
      <a class="btn btn--primary nav__drawer-cta" href={url(PRIMARY_CTA.href)}>{PRIMARY_CTA.label}</a>
      {/* Below the CTA on purpose: findable, and out of the way of the thing we
          actually want a first-time visitor to press. */}
      {PORTAL_URL && (
        <a class="nav__drawer-signin" href={PORTAL_URL} rel="noopener">
          Sign in
        </a>
      )}
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    min-height: 68px;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    margin-right: auto;
  }

  .nav__links {
    display: none;
    align-items: center;
    gap: 0.15rem;
  }

  .nav__link {
    position: relative;
    padding: 0.5rem 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
  }

  .nav__link:hover {
    color: var(--ink);
    background: var(--bg-alt);
  }

  /* The current page is marked by ink weight, not by the accent — the accent
     belongs to the CTA, and a coloured nav link competes with it. */
  .nav__link[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }

  /* Sign in. Deliberately quiet and set apart from the main link group: the
     CTA is the primary action and this must not compete with it. Clients
     arrive here knowing they have an account, so it only has to be findable. */
  .nav__signin {
    display: none;
    align-items: center;
    margin-left: 0.5rem;
    padding: 0.5rem 0 0.5rem 1.25rem;
    border-left: 1px solid var(--line);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur) var(--ease);
  }

  .nav__signin:hover { color: var(--ink); }

  .nav__cta { display: none; margin-left: 0.75rem; }

  /* Burger ---------------------------------------------------------------- */

  .nav__burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0 10px;
    border-radius: var(--radius-sm);
    transition: background var(--dur) var(--ease);
  }

  .nav__burger:hover { background: var(--bg-alt); }

  .nav__burger-bar {
    display: block;
    width: 100%;
    height: 1.5px;
    background: var(--ink);
    transition: transform var(--dur) var(--ease);
  }

  .nav__burger[aria-expanded='true'] .nav__burger-bar:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .nav__burger[aria-expanded='true'] .nav__burger-bar:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* Drawer ---------------------------------------------------------------- */

  .nav__drawer {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .nav__drawer[hidden] { display: none; }

  .nav__drawer-links {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: min(100% - 2.5rem, var(--shell));
    margin-inline: auto;
    padding-block: var(--s-2) var(--s-5);
  }

  .nav__drawer-links a {
    padding: 0.9rem 0.25rem;
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .nav__drawer-links a[aria-current='page'] { font-weight: 600; }

  .nav__drawer-cta {
    margin-top: var(--s-4);
    border-bottom: 0 !important;
    color: #fff !important;
    justify-content: center;
  }

  .nav__drawer-signin {
    margin-top: var(--s-3);
    text-align: center;
    border-bottom: 0 !important;
    font-size: 0.9375rem;
    color: var(--ink-soft) !important;
    font-weight: 500 !important;
  }

  /* Desktop --------------------------------------------------------------- */

  /* 1060, not 900. The desktop row carries five links, a Sign in link and the
     CTA; at 900 it had 81px of slack before any of that was added, so the
     burger keeps the job further up than it used to. Below this the drawer
     holds everything comfortably. */
  @media (min-width: 1060px) {
    .nav__signin { display: inline-flex; }

    .nav__links,
    .nav__cta { display: flex; }
    .nav__burger { display: none; }
    .nav__drawer { display: none !important; }
  }

</style>

<script>
  // --- Mobile drawer -------------------------------------------------------
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');

  if (burger && drawer) {
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      drawer.hidden = !open;
      burger.querySelector('.sr-only')!.textContent = open ? 'Close menu' : 'Open menu';
    };

    burger.addEventListener('click', () => {
      setOpen(burger.getAttribute('aria-expanded') !== 'true');
    });

    // Escape closes the drawer and returns focus to the button.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        burger.focus();
      }
    });

    // Close if the viewport grows past the desktop breakpoint while open.
    const mq = window.matchMedia('(min-width: 900px)');
    mq.addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>
