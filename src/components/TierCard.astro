---
/**
 * One pricing tier, Startup or Maintenance. Used on /pricing in full and as a
 * teaser on the home page, and both read the same entry in site.js, so a
 * price can only be wrong in one place.
 *
 * Nothing on the card is typed: the price, the struck-through list price
 * while beta is on, and the per-revision line are all formatted from the
 * integers in STARTUP_TIERS / MAINTENANCE_TIERS.
 *
 * The per-revision line divides by what the card is actually asking for —
 * the beta price while beta is on — so the two numbers on a card agree.
 */
import { url } from '../data/url.js';
import {
  BETA,
  TIER_CTA,
  EXTRA_REVISION,
  STARTUP_REVISIONS_EXPIRE_DAYS,
  money,
  startupPrice,
  perRevision,
} from '../data/site.js';

interface Props {
  tier: {
    id: string;
    name: string;
    revisions: number;
    price?: number;
    monthly?: number;
    popular?: boolean;
    /** Who the tier is for. Shown on the full card, not the home teaser. */
    fit?: string;
  };
  /** Home page version: name, price and the revision count only. */
  teaser?: boolean;
  reveal?: boolean;
}

const { tier, teaser = false, reveal = false } = Astro.props;

const isStartup = tier.price !== undefined;
const listPrice = isStartup ? tier.price! : tier.monthly!;
const charged = isStartup ? startupPrice(tier) : listPrice;
const discounted = isStartup && BETA.on && charged !== listPrice;

const revisions = (n: number, tail: string) =>
  `${n} revision${n === 1 ? '' : 's'} ${tail}`;

const lines = isStartup
  ? [
      revisions(tier.revisions, 'included'),
      `Use them within ${STARTUP_REVISIONS_EXPIRE_DAYS} days`,
      'Unlimited pages',
    ]
  : [
      revisions(tier.revisions, 'a month'),
      `Extras ${money(EXTRA_REVISION)} each`,
      'Hosting, domain and SSL included',
      'Every version kept',
    ];
---

<article
  class:list={['tier', 'lift', { 'tier--popular': tier.popular, 'tier--teaser': teaser }]}
  data-reveal={reveal ? '' : undefined}
>
  {tier.popular && <span class="tier__flag">Most popular</span>}

  <header class="tier__head">
    <h3 class="tier__name">{tier.name}</h3>
    {!teaser && tier.fit && <p class="tier__fit">{tier.fit}</p>}
    {
      discounted && (
        <p class="tier__was-line">
          <s class="tier__was"><span class="sr-only">List price </span>{money(listPrice)}</s>
        </p>
      )
    }
    <p class="tier__price">
      {discounted && <span class="sr-only">Beta price </span>}
      <span class="tier__fig">{money(charged)}</span>
      {!isStartup && <span class="tier__period">/mo</span>}
    </p>
    {isStartup && <p class="tier__period tier__period--below">one-time</p>}
  </header>

  {teaser ? (
    <p class="tier__teaser-line">{lines[0]}</p>
  ) : (
    <ul class="tier__features">
      {lines.map((f) => <li>{f}</li>)}
    </ul>
  )}

  {!teaser && <p class="tier__per">{money(perRevision(charged, tier.revisions))} per revision</p>}

  {!teaser && (
    <a
      class:list={['btn', tier.popular ? 'btn--primary' : 'btn--secondary', 'tier__cta']}
      href={url(TIER_CTA.href)}
    >
      {TIER_CTA.label}
    </a>
  )}
</article>

<style>
  .tier {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--s-5);
    background: var(--bg);
    border-radius: var(--radius);
  }

  /* Border, shadow, hover rise and their transition come from .lift in
     global.css. */
  .tier:hover { border-color: #d2d5db; }

  .tier--popular {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent), var(--lift);
  }

  .tier--popular:hover {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent), var(--lift-hover);
  }

  .tier__flag {
    position: absolute;
    top: -0.7rem;
    left: var(--s-5);
    padding: 0.22rem 0.6rem;
    background: var(--accent);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 500;
    border-radius: var(--radius-sm);
  }

  .tier__head { margin-bottom: var(--s-4); }
  .tier--teaser .tier__head { margin-bottom: var(--s-3); }

  .tier__name {
    font-size: 1.125rem;
    margin-bottom: 0.6rem;
  }

  .tier__name:has(+ .tier__fit) { margin-bottom: 0.35rem; }

  .tier__fit {
    margin-bottom: 0.85rem;
    font-size: var(--t-small);
    color: var(--ink-soft);
  }

  .tier__price {
    display: flex;
    align-items: baseline;
    gap: 0.12rem;
    /* Inter, not the mono. A price is the largest thing on the card and
       mono figures read as a terminal readout rather than a number someone
       is being asked to pay. tabular-nums is on the figure only: on the
       whole line it would also widen the slash in "/mo". */
    font-family: var(--font-body);
    font-size: clamp(2.5rem, 2.1rem + 1.4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--ink);
  }

  .tier__fig { font-variant-numeric: tabular-nums; }

  .tier__period {
    font-family: var(--font-body);
    font-size: var(--t-small);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ink-muted);
  }

  .tier__period--below { margin-top: 0.35rem; }

  /* The list price sits on its own line above the figure, struck through.
     Inline, the grey number collided with the black one and the strike was
     hard to see at that size. --ink-soft, not --ink-muted: this is a price
     someone might compare, and muted is the caption grey. */
  .tier__was-line { margin-bottom: 0.4rem; }

  .tier__was {
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ink-soft);
    text-decoration-thickness: 1.5px;
    font-variant-numeric: tabular-nums;
  }

  .tier__teaser-line {
    color: var(--ink-soft);
    font-size: var(--t-small);
  }

  .tier__features {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: var(--s-4);
  }

  .tier__features li {
    position: relative;
    padding-left: 1.4rem;
    font-size: var(--t-small);
    color: var(--ink-soft);
    line-height: 1.5;
  }

  .tier__features li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  /* Pushed to the bottom with the button, so a row of cards lines up on
     both. */
  /* The deal: this is the line that says a larger plan costs less per
     change, so it is body ink, not the caption grey. Tabular figures on
     the whole line would widen the spaces in "per revision". */
  .tier__per {
    margin-top: auto;
    font-size: var(--t-small);
    font-weight: 550;
    color: var(--ink);
  }

  .tier__cta { margin-top: var(--s-4); width: 100%; }
</style>
