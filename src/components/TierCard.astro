---
/**
 * A pricing tier card. Used twice: condensed on the home page teaser, and in
 * full on /pricing. Tier content lives in TIERS in src/data/site.js.
 */
import { url } from '../data/url.js';

interface Props {
  tier: {
    id: string;
    name: string;
    price: string;
    tagline: string;
    pages: string;
    revisions: string;
    design: string;
    delivery: string;
    like: string;
    likeHref: string;
    popular?: boolean;
    features: string[];
  };
  /** Home page version: fewer lines, no spec table */
  condensed?: boolean;
  reveal?: boolean;
}

const { tier, condensed = false, reveal = false } = Astro.props;
---

<article
  class:list={['tier', { 'tier--popular': tier.popular }]}
  data-reveal={reveal ? '' : undefined}
>
  {tier.popular && <span class="tier__flag">Most popular</span>}

  <header class="tier__head">
    <h3 class="tier__name">{tier.name}</h3>
    <p class="tier__price">{tier.price}</p>
    <p class="tier__tagline">{tier.tagline}</p>
  </header>

  {
    condensed ? (
      <ul class="tier__quick">
        <li>{tier.pages}</li>
        <li>{tier.revisions}</li>
        <li>{tier.delivery}</li>
      </ul>
    ) : (
      <>
        <dl class="tier__spec">
          <div><dt>Pages</dt><dd>{tier.pages}</dd></div>
          <div><dt>Revisions</dt><dd>{tier.revisions}</dd></div>
          <div><dt>Design</dt><dd>{tier.design}</dd></div>
          <div><dt>Delivery</dt><dd>{tier.delivery}</dd></div>
        </dl>

        <ul class="tier__features">
          {tier.features.map((f) => <li>{f}</li>)}
        </ul>
      </>
    )
  }

  <p class="tier__like">
    <a href={url(tier.likeHref)} target="_blank" rel="noopener noreferrer">
      {tier.like}
      <span class="sr-only">(opens in a new tab)</span>
    </a>
  </p>

  <a
    class:list={['btn', tier.popular ? 'btn--primary' : 'btn--secondary', 'tier__cta']}
    href={url('/contact')}
  >
    Start with a free mockup
  </a>
</article>

<style>
  .tier {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--s-5);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color var(--dur) var(--ease);
  }

  .tier:hover { border-color: #d2d5db; }

  /* The recommended tier is marked with the accent — the one moment of
     emphasis in the row, and the only place colour does the work. */
  .tier--popular {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .tier--popular:hover { border-color: var(--accent); }

  .tier__flag {
    position: absolute;
    top: -0.7rem;
    left: var(--s-5);
    padding: 0.22rem 0.6rem;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: var(--radius-sm);
  }

  .tier__head { margin-bottom: var(--s-4); }

  .tier__name {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
  }

  .tier__price {
    font-family: var(--font-mono);
    font-size: 2.25rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--ink);
    margin-bottom: var(--s-3);
  }

  .tier__tagline {
    color: var(--ink-soft);
    font-size: var(--t-small);
    line-height: 1.5;
  }

  .tier__quick,
  .tier__features {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-bottom: var(--s-4);
  }

  .tier__quick li,
  .tier__features li {
    position: relative;
    padding-left: 1.4rem;
    font-size: var(--t-small);
    color: var(--ink-soft);
    line-height: 1.5;
  }

  .tier__quick li::before,
  .tier__features li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .tier__spec {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-block: var(--s-3);
    margin-bottom: var(--s-3);
    border-block: 1px solid var(--line);
  }

  .tier__spec > div {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    align-items: baseline;
  }

  .tier__spec dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    flex-shrink: 0;
  }

  .tier__spec dd {
    text-align: right;
    font-size: var(--t-small);
    color: var(--ink-soft);
    line-height: 1.4;
  }

  .tier__like {
    margin-top: auto;
    padding-top: var(--s-3);
    font-size: var(--t-small);
    color: var(--ink-muted);
  }

  .tier__like a { color: var(--accent); }

  .tier__cta { margin-top: var(--s-4); width: 100%; }
</style>
