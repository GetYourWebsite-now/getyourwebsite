---
/**
 * One build tier. Used twice — condensed on the home teaser, in full on
 * /pricing — and both read the same entry in TIERS, so a price can only be
 * wrong in one place.
 *
 * There is no `delivery` row any more, on purpose: see the note above TIERS
 * in src/data/site.js. And `examples` only ever points at real client work,
 * so a tier with nothing shipped under it yet shows nothing rather than
 * borrowing a concept site.
 */
import { url } from '../data/url.js';

interface Props {
  tier: {
    id: string;
    name: string;
    price: string;
    period?: string;
    tagline: string;
    popular?: boolean;
    features: string[];
    examples?: { name: string; href: string }[];
  };
  /** Home page version: tagline and a short feature list, no examples. */
  condensed?: boolean;
  reveal?: boolean;
}

const { tier, condensed = false, reveal = false } = Astro.props;

// Custom is scoped per project, so "Start with a free mock" is the wrong
// first step for it — that conversation starts with the project.
const isCustom = tier.id === 'custom';
const ctaLabel = isCustom ? 'Tell us about the project' : 'Start with a free mock';
const ctaHref = isCustom ? '/contact' : '/free-mock';

const features = condensed ? tier.features.slice(0, 4) : tier.features;
---

<article
  class:list={['tier', { 'tier--popular': tier.popular }]}
  data-reveal={reveal ? '' : undefined}
>
  {tier.popular && <span class="tier__flag">Most popular</span>}

  <header class="tier__head">
    <h3 class="tier__name">{tier.name}</h3>
    <p class="tier__price">
      {tier.price}
      {tier.period && <span class="tier__period">{tier.period}</span>}
    </p>
    <p class="tier__tagline">{tier.tagline}</p>
  </header>

  <ul class="tier__features">
    {features.map((f) => <li>{f}</li>)}
  </ul>

  {
    !condensed && tier.examples && tier.examples.length > 0 && (
      <p class="tier__example">
        <span class="tier__example-label">Built this way:</span>
        {/* The anchor is on one line because a newline inside it becomes a
            text node and the underline runs under the resulting space. The
            comment lives out here: inside the map's return position it would
            be a second expression, which is a compile error. */}
        {tier.examples.map((ex) => (
          <a class="tier__example-link" href={ex.href} target="_blank" rel="noopener noreferrer">{ex.name}<span class="sr-only"> (opens in a new tab)</span></a>
        ))}
      </p>
    )
  }

  <a
    class:list={['btn', tier.popular ? 'btn--primary' : 'btn--secondary', 'tier__cta']}
    href={url(ctaHref)}
  >
    {ctaLabel}
  </a>
</article>

<style>
  .tier {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--s-5);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color var(--dur) var(--ease);
  }

  .tier:hover { border-color: #d2d5db; }

  .tier--popular {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .tier--popular:hover { border-color: var(--accent); }

  .tier__flag {
    position: absolute;
    top: -0.7rem;
    left: var(--s-5);
    padding: 0.22rem 0.6rem;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: var(--radius-sm);
  }

  .tier__head { margin-bottom: var(--s-4); }

  .tier__name {
    font-size: 1.125rem;
    margin-bottom: 0.6rem;
  }

  .tier__price {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    flex-wrap: wrap;
    /* Inter, not the mono. A price is the largest thing on the card and
       mono figures read as a terminal readout rather than a number someone
       is being asked to pay. tabular-nums keeps the three cards' digits on
       the same rhythm, which is the only thing mono was buying here.
       Tracking is looser than the mono's -0.045em because that value was
       tuned for a monospaced face and is cramped on Inter. */
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
    font-size: clamp(2.5rem, 2.1rem + 1.4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--ink);
    margin-bottom: var(--s-3);
  }

  .tier__period {
    font-family: var(--font-body);
    font-size: var(--t-small);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ink-muted);
  }

  .tier__tagline {
    color: var(--ink-soft);
    font-size: var(--t-small);
    line-height: 1.5;
  }

  .tier__features {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: var(--s-4);
  }

  .tier__features li {
    position: relative;
    padding-left: 1.4rem;
    font-size: var(--t-small);
    color: var(--ink-soft);
    line-height: 1.5;
  }

  .tier__features li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .tier__example {
    margin-top: auto;
    padding-top: var(--s-3);
    font-size: var(--t-small);
    color: var(--ink-muted);
  }

  /* The separator is a middle dot rather than a comma, and that is a
     whitespace decision as much as a typographic one: the newline between
     two sibling <a>s in the template collapses to a space, so a comma
     renders as " , ". A dot wants a space on either side anyway. */
  .tier__example-link + .tier__example-link::before {
    content: '·';
    /* inline-block so the separator sits outside the link's underline —
       text-decoration does not propagate into an atomic inline box. */
    display: inline-block;
    margin-inline: 0.3em;
    color: var(--ink-muted);
  }

  .tier__cta { margin-top: var(--s-4); width: 100%; }

  /* With no example, the button still has to sit at the bottom of the card
     so a row of tiers lines up. */
  .tier:not(:has(.tier__example)) .tier__cta { margin-top: auto; }
</style>
