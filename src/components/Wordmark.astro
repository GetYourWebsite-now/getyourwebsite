---
/**
 * The GetYourWebsite lockup: a planet-with-orbit mark plus the wordmark. The
 * same mark is used for the favicon (public/favicon.svg) and the social card,
 * so if you redraw it, redraw it in all three places.
 *
 * Why the orbit ring and the crescent are ink rather than gold
 * -----------------------------------------------------------
 * The site is light now, and --gold on white measures 1.65:1. An all-gold
 * mark on a white nav is very nearly invisible — the logo half-disappearing
 * is a real cost on a site whose whole argument is that it looks credible.
 * So the gold disc keeps the brand colour and the ink ring and terminator
 * give the mark structure that survives on white. On the footer's dark
 * surface the structure flips to white, via --mark-line.
 *
 * The mark is decorative and aria-hidden — the accessible name comes from the
 * wordmark text, or from the link's aria-label where the mark stands alone —
 * so it is not subject to WCAG 1.4.11. Legibility is the reason here, not
 * conformance.
 */
interface Props {
  /** Hide the text and show just the mark */
  markOnly?: boolean;
  size?: 'sm' | 'md';
}

const { markOnly = false, size = 'md' } = Astro.props;
---

<span class:list={['wordmark', `wordmark--${size}`]}>
  <svg
    class="wordmark__mark"
    viewBox="0 0 32 32"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <!-- planet -->
    <circle cx="16" cy="16" r="7" fill="var(--gold)"></circle>
    <!-- the bite that gives it a crescent/terminator -->
    <circle cx="12.5" cy="13" r="6" fill="var(--mark-line)" opacity="0.22"></circle>
    <!-- orbit ring, tilted -->
    <ellipse
      cx="16"
      cy="16"
      rx="14.2"
      ry="5.4"
      stroke="var(--mark-line)"
      stroke-width="1.6"
      transform="rotate(-28 16 16)"></ellipse>
  </svg>

  {!markOnly && <span class="wordmark__text">GetYourWebsite</span>}
</span>

<style>
  .wordmark {
    --mark-line: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .wordmark__mark {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    overflow: visible;
  }

  .wordmark__text {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--ink);
    white-space: nowrap;
  }

  .wordmark--sm .wordmark__mark { width: 24px; height: 24px; }
  .wordmark--sm .wordmark__text { font-size: 1rem; }

  /* On the footer's dark surface the structure and the text flip to white. */
  :global(.foot) .wordmark { --mark-line: #ffffff; }
  :global(.foot) .wordmark__text { color: #ffffff; }
</style>
