---
/**
 * The GetYourWebsite lockup: the mark plus the wordmark.
 *
 * The mark is a rounded pointy-top hexagon with one stepped cutout
 * (public/brand/mark.svg is the source). It is inlined rather than loaded as
 * an <img> so it can take its colour from the page: the hexagon is
 * currentColor and the cutout is --mark-page, which is whatever surface the
 * mark sits on — so it reads as a hole. Indigo on white in the nav, white
 * on the footer's dark surface.
 *
 * The same drawing is the favicon (public/favicon.svg), the apple-touch icon
 * and the mark on the social card (both generated by tools/og.mjs), and the
 * mark MergeAnim draws in on the home page. The /demo sandbox keeps the
 * portal's own mark. Redraw this one in public/brand/mark.svg and follow it
 * to the marketing surfaces.
 *
 * Decorative and aria-hidden: the accessible name comes from the wordmark
 * text, or from the link's aria-label where the mark stands alone.
 *
 * Gold retired from the logo in Phase 7. --gold is the free-mock badge only.
 */
interface Props {
  /** Hide the text and show just the mark */
  markOnly?: boolean;
}

const { markOnly = false } = Astro.props;
---

<span class="wordmark">
  <svg class="wordmark__mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <path d="M31.32 2.37L32.68 2.37L33.42 2.62L56.63 15.95L57.74 16.94L58.23 18.05L58.23 45.95L57.74 47.06L57.00 47.80L55.77 48.54L33.42 61.38L32.68 61.63L31.32 61.63L29.72 60.89L7.62 48.17L6.26 47.06L5.77 45.95L5.77 18.05L6.14 17.19L7.00 16.20L8.23 15.46L29.72 3.11L30.83 2.49L31.20 2.49Z" fill="currentColor"></path>
    <path d="M27.25 36.69L27.37 36.81L27.37 44.22L27.25 44.35L27.49 45.21L28.48 46.07L44.78 46.07L45.27 45.83L46.01 44.84L46.01 28.67L45.89 28.30L44.90 27.43L36.75 27.43L36.63 27.31L36.63 19.90L36.75 19.78L36.51 18.91L35.52 18.05L19.22 18.05L18.73 18.30L17.99 19.28L17.99 35.46L18.11 35.83L19.10 36.69L27.12 36.69Z" fill="var(--mark-page)"></path>
  </svg>

  {!markOnly && <span class="wordmark__text">GetYourWebsite</span>}
</span>

<style>
  .wordmark {
    --mark-page: var(--bg);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent);
  }

  .wordmark__mark {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .wordmark__text {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--ink);
    white-space: nowrap;
  }

  /* On the footer's dark surface the mark goes white with footer-coloured
     pages, and the text goes white. */
  :global(.foot) .wordmark { color: #ffffff; --mark-page: var(--footer); }
  :global(.foot) .wordmark__text { color: #ffffff; }
</style>
