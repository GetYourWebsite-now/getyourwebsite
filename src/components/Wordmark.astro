---
/**
 * The GetYourWebsite lockup: the mark plus the wordmark.
 *
 * The mark is a pointy-top hexagon holding two overlapping pages, one flat
 * fill (public/brand/mark.svg is the source). It is inlined rather than
 * loaded as an <img> so it can take its colour from the page: the hexagon is
 * currentColor and the pages are --mark-page, which is whatever surface the
 * mark sits on — so they read as cut-outs. Indigo on white in the nav, white
 * on the footer's dark surface.
 *
 * The same drawing is the favicon (public/favicon.svg), the apple-touch icon
 * and the mark on the social card (both generated by tools/og.mjs), the
 * sidebar logo in the /demo sandbox, and the mark MergeAnim draws in on the
 * home page. Redraw it in public/brand/mark.svg and follow it to all of them.
 *
 * Decorative and aria-hidden: the accessible name comes from the wordmark
 * text, or from the link's aria-label where the mark stands alone.
 *
 * Gold retired from the logo in Phase 7. --gold is the free-mock badge only.
 */
interface Props {
  /** Hide the text and show just the mark */
  markOnly?: boolean;
}

const { markOnly = false } = Astro.props;
---

<span class="wordmark">
  <svg class="wordmark__mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <path d="M32 2 L58 17 L58 47 L32 62 L6 47 L6 17 Z" fill="currentColor"></path>
    <rect x="18" y="18" width="18" height="18" fill="var(--mark-page)"></rect>
    <rect x="28" y="28" width="18" height="18" fill="var(--mark-page)"></rect>
  </svg>

  {!markOnly && <span class="wordmark__text">GetYourWebsite</span>}
</span>

<style>
  .wordmark {
    --mark-page: var(--bg);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent);
  }

  .wordmark__mark {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .wordmark__text {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--ink);
    white-space: nowrap;
  }

  /* On the footer's dark surface the mark goes white with footer-coloured
     pages, and the text goes white. */
  :global(.foot) .wordmark { color: #ffffff; --mark-page: var(--footer); }
  :global(.foot) .wordmark__text { color: #ffffff; }
</style>
