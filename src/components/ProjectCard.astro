---
/**
 * One card in the Our Work grid.
 *
 * To add a project: put its HTML in public/, save a screenshot to
 * public/shots/<slug>.webp, then add an entry to PROJECTS in src/data/site.js.
 * Nothing here needs editing.
 */
import { url } from '../data/url.js';

interface Props {
  project: {
    slug: string;
    name: string;
    type: string;
    href: string;
    shot: string;
    blurb: string;
  };
  reveal?: boolean;
  /**
   * The concept-site treatment: smaller type, tighter padding, no hover
   * lift. These sit below the real client work on /work and must not
   * compete with it — the hierarchy is what keeps the page honest about
   * which of these someone actually paid for.
   */
  quiet?: boolean;
  /**
   * Heading level for the business name. On /work the cards sit directly under
   * the page's h1, so they're h2; on the home page they sit under a section h2,
   * so they're h3. Getting this wrong skips a level and fails accessibility
   * checks, hence the prop rather than a hardcoded tag.
   */
  level?: 2 | 3;
}

const { project, reveal = false, level = 3, quiet = false } = Astro.props;
const Heading = `h${level}`;
---

<article class:list={['project', { 'project--quiet': quiet }]} data-reveal={reveal ? '' : undefined}>
  <a class="project__shot" href={url(project.href)} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
    <img
      src={url(project.shot)}
      alt=""
      width="800"
      height="600"
      loading="lazy"
      decoding="async"
    />
  </a>

  <div class="project__body">
    <span class="badge">{project.type}</span>
    <Heading>{project.name}</Heading>
    <p>{project.blurb}</p>

    <a
      class="link-arrow project__link"
      href={url(project.href)}
      target="_blank"
      rel="noopener noreferrer"
    >
      View live site
      <span class="sr-only">— {project.name} (opens in a new tab)</span>
    </a>
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color var(--dur) var(--ease);
  }

  .project:hover,
  .project:focus-within { border-color: #d2d5db; }

  .project__shot {
    display: block;
    overflow: hidden;
    background: var(--bg-alt);
    border-bottom: 1px solid var(--line);
    aspect-ratio: 4 / 3;
  }

  .project__shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .project__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-2);
    padding: var(--s-4);
    flex: 1;
  }

  .project__body :is(h2, h3) { margin-top: 0.2rem; font-size: var(--t-h3); }

  .project__body p {
    color: var(--ink-soft);
    font-size: var(--t-small);
    flex: 1;
  }

  .project__link { margin-top: var(--s-2); }

  /* Quiet variant ---------------------------------------------------------- */

  .project--quiet .project__body { padding: var(--s-3); gap: 0.35rem; }
  .project--quiet .project__body :is(h2, h3) { font-size: 1rem; margin-top: 0.1rem; }
  .project--quiet .project__body p { font-size: var(--t-label); line-height: 1.5; }
  .project--quiet .project__link { font-size: var(--t-label); margin-top: var(--s-2); }
  .project--quiet .badge { font-size: 0.6875rem; padding: 0.2rem 0.45rem; }
</style>
