---
/**
 * The beta promotion code. Mono, because it is a code. No tracking:
 * the letters are the code, not a label style.
 *
 * `plain` drops the chip, for a sentence that should stay one piece of type.
 */
import { BETA } from '../data/site.js';

interface Props {
  plain?: boolean;
}

const { plain = false } = Astro.props;
---

<span class:list={['promo-code', { 'promo-code--plain': plain }]}>{BETA.code}</span>

<style>
  .promo-code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    font-weight: 500;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.05em 0.4em;
    white-space: nowrap;
  }

  .promo-code--plain {
    font-size: 0.92em;
    font-weight: inherit;
    color: var(--accent);
    background: none;
    border: 0;
    padding: 0;
    border-radius: 0;
  }
</style>
