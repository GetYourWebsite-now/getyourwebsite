---
import { NAV_LINKS, CONTACT_EMAIL, SOCIALS, PORTAL_URL } from '../data/site.js';
import { url } from '../data/url.js';
import Wordmark from './Wordmark.astro';

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="shell foot__inner">
    <div class="foot__brand">
      <a href={url('/')} aria-label="GetYourWebsite — home">
        <Wordmark />
      </a>
      <p class="foot__line">Websites for local businesses, built and maintained by the people you talk to.</p>
    </div>

    <nav class="foot__nav" aria-label="Footer">
      <h2 class="foot__heading">Pages</h2>
      <ul>
        <li><a href={url('/')}>Home</a></li>
        {NAV_LINKS.map((link) => <li><a href={url(link.href)}>{link.label}</a></li>)}
        {/* Not in NAV_LINKS any more — "How it works" took its header slot —
            but still a live page, so it stays reachable from here. */}
        <li><a href={url('/benefits')}>Benefits</a></li>
        {PORTAL_URL && (
          <li>
            <a href={PORTAL_URL} rel="noopener">Sign in</a>
          </li>
        )}
        <li><a href={url('/contact')}>Contact</a></li>
      </ul>
    </nav>

    <div class="foot__contact">
      <h2 class="foot__heading">Get in touch</h2>
      <ul>
        <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
        {SOCIALS.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
          </li>
        ))}
      </ul>
      <a class="btn btn--primary btn--sm foot__cta" href={url('/free-mock')}>Get a free mock</a>
    </div>
  </div>

  <div class="shell foot__base">
    <p>&copy; {year} GetYourWebsite</p>
    <p class="foot__legal">
      <a href={url('/privacy')}>Privacy</a>
      <a href={url('/terms')}>Terms</a>
    </p>
  </div>
</footer>

<style>
  /* The one dark surface on the site. Flat — no stars, no sheen, no drift.
     Footer ink is #c9ccd2 on #0a0a0c, which measures 12.29:1. */
  .foot {
    background: var(--footer);
    color: var(--footer-ink);
    padding-block: var(--s-7) var(--s-4);
  }

  .foot__inner {
    display: grid;
    gap: var(--s-6);
    grid-template-columns: 1fr;
    padding-bottom: var(--s-6);
  }

  .foot__line {
    margin-top: var(--s-3);
    max-width: 24rem;
    color: var(--footer-ink);
    font-size: var(--t-small);
  }

  .foot__heading {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: var(--s-3);
  }

  .foot__nav ul,
  .foot__contact ul {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .foot a {
    color: var(--footer-ink);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color var(--dur) var(--ease);
  }

  .foot a:hover { color: #fff; text-decoration: underline; }

  /* The primary button inverts to a white fill on this surface (global.css),
     so its label has to be ink. This rule lives here rather than there
     because `.foot a` above is scoped, and a scoped selector outranks the
     unscoped one in global.css whatever order they land in. */
  /* `.foot a.foot__cta`, not `.foot__cta`. The `.foot a` rule above is
     (0,2,1) once Astro's scoping attribute is added, so a bare `.foot__cta`
     at (0,2,0) loses to it and the label stays footer-grey on the white
     fill — which is what `npm run verify:contrast` caught at 1.61:1. */
  .foot a.foot__cta {
    margin-top: var(--s-4);
    color: var(--ink);
    text-decoration: none;
  }

  .foot a.foot__cta:hover { color: var(--ink); text-decoration: none; }

  .foot__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-2) var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--footer-line);
    font-size: 0.82rem;
    color: var(--footer-ink);
  }

  .foot__legal {
    display: flex;
    gap: var(--s-4);
  }

  .foot .foot__legal a { font-size: 0.82rem; }

  @media (min-width: 700px) {
    .foot__inner { grid-template-columns: 1.4fr 1fr 1fr; }
  }
</style>
